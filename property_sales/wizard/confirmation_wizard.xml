<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_invoice_schedule_confirm_wizard" model="ir.ui.view">
        <field name="name">invoice.schedule.confirm.wizard.form</field>
        <field name="model">invoice.schedule.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmation">
                <group>
                    <label string="Advance is not Created. Do you want to continue?" for="line_id"/>
                    <field name="line_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_yes" string="Yes" type="object" class="btn-primary"/>
                    <button name="action_no" string="No" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>