<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_retention_wizard" model="ir.ui.view">
        <field name="name">advance.retention.form.view</field>
        <field name="model">advance.retention.wizard</field>
        <field name="arch" type="xml">
            <form string="Property Blocking">
                <group>
                    <group>
                        <field name="already_created"/>
                        <field name="amount" invisible="already_created" readonly="1"/>
                        <field name="date" invisible="already_created" required="1"/>
                        <field name="partner_id" invisible="already_created" required="1"/>
                    </group>
                    <group>
                        <field name="bill_id" invisible="not already_created" required="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_add_done" type="object"
                            string="Done" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>