<?xml version="1.0" encoding="utf-8"?>
<odoo>
           <record id="view_offer_payment_update_wizard_wizard" model="ir.ui.view">
            <field name="name">offer.payment.update.wizard.form</field>
            <field name="model">offer.payment.update.wizard</field>
            <field name="arch" type="xml">
                <form string="Offer Payment Update">
                    <group>
                        <field name="sale_order"/>
                        <field name="final_total_property_value"/>
                    </group>

                      <notebook>
                        <page string="Payment Lines" name="payment_lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="in_offer" />
                                    <field name="plan_date"  />
                                    <field name="percentage"  sum="Total Percentage"/>
                                    <field name="amount" readonly="1" sum="Total Amount"/>
                                    <field name="rounded_amount" readonly="1" sum="Total Rounded Amount" column_invisible="1"/>
                                </list>
                            </field>
                            </page>
                      </notebook>
                    <footer>
                        <button string="Confirm"
                                name="action_confirm_update"
                                type="object"
                                class="btn btn-primary"/>
                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

     <record id="action_offer_payment_update_wizard_upload" model="ir.actions.act_window">
        <field name="name">Offer Payment Update</field>
        <field name="res_model">offer.payment.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_offer_payment_update_wizard_wizard"/>
    </record>


     <record id="view_booking_payment_update_wizard_wizard" model="ir.ui.view">
            <field name="name">booking.payment.update.wizard.form</field>
            <field name="model">booking.payment.update.wizard</field>
            <field name="arch" type="xml">
                <form string="Booking Payment Update">
                    <group>
                        <field name="booking_id"/>
                        <field name="final_total_property_value"/>
                    </group>

                      <notebook>
                        <page string="Payment Lines" name="payment_lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"  readonly="inv_created ==True"/>
                                    <field name="inv_created"  readonly="1" column_invisible="1"/>
                                    <field name="plan_date"  readonly="inv_created ==True" />
                                    <field name="percentage"  sum="Total Percentage" readonly="inv_created ==True" />
                                    <field name="amount" readonly="1" sum="Total Amount"/>
                                    <field name="rounded_amount" readonly="1" sum="Total Rounded Amount" column_invisible="1"/>
                                </list>
                            </field>
                            </page>
                      </notebook>
                    <footer>
                        <button string="Confirm"
                                name="action_confirm_update"
                                type="object"
                                class="btn btn-primary"/>
                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

     <record id="action_booking_payment_update_wizard_upload" model="ir.actions.act_window">
        <field name="name">Booking Payment Update</field>
        <field name="res_model">booking.payment.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_booking_payment_update_wizard_wizard"/>
    </record>

</odoo>