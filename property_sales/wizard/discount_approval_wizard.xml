<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_discount_request_wizard_form" model="ir.ui.view">
        <field name="name">discount.request.wizard.form</field>
        <field name="model">discount.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Discount Request">
                <group>
                    <field name="sale_order" readonly="1"/>
                    <field name="request_percentage" readonly="1"/>
                </group>
                   <field name="reason_for_request" placeholder="Request Reason......."/>
                <footer>
                    <button type="object" name="action_request_for_discount" string="Request" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_discount_request_wizard" model="ir.actions.act_window">
        <field name="name">Discount Request</field>
        <field name="res_model">discount.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_discount_request_wizard_form"/>
    </record>
</odoo>