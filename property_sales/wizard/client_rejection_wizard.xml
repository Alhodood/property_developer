<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_retention_wizard" model="ir.ui.view">
        <field name="name">client.rejection.wizard.form.view</field>
        <field name="model">client.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Client Rejection">
                <group>
                    <field name="reason" required="1"/>
                </group>
                <footer>
                    <button name="action_client_reject" type="object"
                            string="Reject" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>