<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_spa_add_pdc_wizard_form" model="ir.ui.view">
            <field name="name">spa.add.pdc.wizard.form</field>
            <field name="model">spa.add.pdc.wizard</field>
            <field name="arch" type="xml">
                <form string="Add PDC">
                    <group>
                        <field name="spa_id" readonly="1"/>
                        <field name="property_project_id" readonly="1"/>
                        <field name="property_unit_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="bank"/>
                        <field name="cheque_pay_name"/>
                    </group>

                    <field name="line_ids">
                        <list editable="bottom" limit="200">
                             <field name="wizard_id" column_invisible="1"/>
                            <field name="date"/>
                            <field name="cheque_number"/>
                            <field name="amount"/>
                        </list>
                    </field>

                    <footer>
                        <button string="Done"
                                name="action_done"
                                type="object"
                                class="btn btn-primary"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>



     <record id="action_add_pdc_spa_cheque" model="ir.actions.act_window">
        <field name="name">Collect PDC</field>
        <field name="res_model">spa.add.pdc.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_spa_add_pdc_wizard_form"/>
    </record>
</odoo>