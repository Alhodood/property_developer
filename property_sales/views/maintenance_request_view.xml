<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_equipment_request_view_form_inherit_property_sales" model="ir.ui.view">
        <field name="name">maintenance.request.view.form.sales</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <field name="equipment_id" position="before">
                <field name="property_type"/>
                <field name="property_project_id" invisible="property_type != 'sale'"/>
                <field name="property_unit_id" invisible="property_type != 'sale'"/>
                <field name="snagging_unit" invisible="1"/>
            </field>
        </field>
    </record>


</odoo>
