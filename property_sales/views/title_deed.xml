<?xml version="1.0" encoding="UTF-8"?>
<odoo>
     <record id="view_form_title_deed_page" model="ir.ui.view">
        <field name="name">title.deed.form.view</field>
        <field name="model">title.deed</field>
        <field name="arch" type="xml">
            <form string="Title Deed">
                <style>
                    .card-header {
                    display: flex;
                    align-items: center;
                    cursor: pointer;
                    font-size:14px;
                    }

                    .card-header .arrow {
                    transition: transform 0.3s ease;
                    font-size: 16px;
                    }

                    /* Rotate when open */
                    .card-header.collapsed .arrow {
                    transform: rotate(-90deg);
                    }
                    .strong_tab{
                    margin-left:1%;
                    }
                    .card{
                    margin-bottom:1%;
                    }
                    .strong_gap{
                    display:inline-block;
                    min-width:140px;
                    }
                </style>
                <header>
                    <field name="state" widget="statusbar" readonly="1"
                           options="{'clickable': '0'}"/>
                     <button name="action_set_in_progress"
                        string="Mark In Progress"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'not_applied'"/>
                     <button name="action_set_issued"
                                string="Mark Issued"
                                type="object"
                                class="btn-success"
                                invisible="state != 'in_progress'"/>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="sequence" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="oqood_id" required="1"   options="{'no_create_edit': True,'no_create': True, 'no_open': True}"/>
                            <field name="crm_user_id" required="1"   options="{'no_create_edit': True,'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                             <field name="partner_id" readonly="1"   options="{'no_create_edit': True,'no_create': True, 'no_open': True}"/>
                             <field name="spa_id" readonly="1"   options="{'no_create_edit': True,'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Property DETAILS" name="project_details">
                            <div class="card">
                                <div class="card-header"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#prjdetail-section"
                                     aria-expanded="true">
                                    <span class="arrow">▼</span>
                                    <strong class="strong_tab">PROPERTY DETAILS
                                    </strong>
                                </div>
                                <div id="prjdetail-section"
                                     class="collapse show">
                                    <div class="card-body"
                                         style="display: flex; justify-content: space-between; gap: 40px;">
                                        <div style="flex: 1;">
                                             <p>
                                                <strong class="strong_gap">
                                                    Property:
                                                </strong>
                                                <field name="property_project_id"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">
                                                    Company:
                                                </strong>
                                                <field name="company_id"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Currency:
                                                </strong>
                                                <field name="currency_id"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">
                                                    Agent:
                                                </strong>
                                                <field name="lead_agent_id"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">
                                                    Unit:
                                                </strong>
                                                <field name="property_unit_id"
                                                       required="1"/>
                                            </p>
                                        </div>
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Project Name Ar(إســم
                                                    الـمشروع):
                                                </strong>
                                                <field name="project_name_arabic"
                                                       style="padding-left:2%;"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Company Arabic:
                                                </strong>
                                                <field name="company_arabic"
                                                       style="padding-left:2%;"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    DLD Reference:
                                                </strong>
                                                <field name="dld_reference_no"
                                                       readonly="1"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                   Issue Date:
                                                </strong>
                                                <field name="issue_date"
                                                       readonly="1"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">Client ID:
                                                </strong>
                                                <field name="client_id"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Client Sign Date:
                                                </strong>
                                                <field name="client_sign_date"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Chairman Sign Date:
                                                </strong>
                                                <field name="chairman_sign_date"/>
                                            </p>

                                        </div>
                                    </div>
                                </div>
                            </div>
                               <div class="card">
                                <div class="card-header collapsed"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#system-section"
                                     aria-expanded="false">
                                    <span class="arrow">▼</span>
                                    <strong class="strong_tab">System
                                        Information
                                    </strong>
                                </div>
                                <div id="system-section" class="collapse">
                                    <div class="card-body"
                                         style="display: flex; justify-content: space-between; gap: 40px;">

                                        <!-- First Column -->
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Created
                                                    By:
                                                </strong>
                                                <field name="create_uid"/>
                                                <field name="create_date"
                                                       style="margin-left:1%;"/>
                                            </p>
                                        </div>

                                        <!-- Second Column -->
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">Last
                                                    Modified By:
                                                </strong>
                                                <field name="write_uid"/>
                                                <field name="write_date"
                                                       style="margin-left:1%;"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                 <chatter/>
            </form>
        </field>
    </record>


     <record id="view_title_deed_tree" model="ir.ui.view">
        <field name="name">title.deed.tree.view</field>
        <field name="model">title.deed</field>
        <field name="arch" type="xml">
            <list string="Title Deed" create="1" delete="1">
                <field name="sequence" readonly="1"/>
                <field name="crm_user_id" readonly="1"/>
                <field name="activity_ids" optional="hide" widget="list_activity"/>
                <field name="activity_user_id" optional="hide" string="Activity by" widget="many2one_avatar_user"/>
                <field name="property_project_id" readonly="1"/>
                <field name="property_unit_id" readonly="1"/>
                <field name="company_id" readonly="1"/>
                <field name="state" readonly="1"/>
            </list>
        </field>
    </record>

     <record id="view_title_deed_line_search" model="ir.ui.view">
        <field name="name">title.deed.search.view</field>
        <field name="model">title.deed</field>
        <field name="arch" type="xml">
            <search string="Title Deed">
                 <field name="sequence"/>
                <field name="crm_user_id" />
                <field name="property_project_id"/>
                <field name="property_unit_id" />
                <field name="company_id"/>
                <field name="state" />

                <filter string="Not Applied"
                    name="not_applied"
                    domain="[('state','=','not_applied')]"/>

            <filter string="In Progress"
                    name="in_progress"
                    domain="[('state','=','in_progress')]"/>

            <filter string="Issued"
                    name="issued"
                    domain="[('state','=','issued')]"/>
                <group>
                    <filter string="Project" name="group_project"
                            context="{'group_by':'property_project_id'}"/>
                    <filter string="Unit" name="group_unit"
                            context="{'group_by':'property_unit_id'}"/>
                     <filter string="CRM User"
                        name="group_by_crm"
                        context="{'group_by':'crm_user_id'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

      <record id="action_title_deed_state" model="ir.actions.act_window">
        <field name="name">Title Deed</field>
        <field name="res_model">title.deed</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_title_deed_tree"/>
        <field name="search_view_id" ref="view_title_deed_line_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>
                Create and manage your PropertyTitle Deed
            </p>
        </field>
    </record>

     <menuitem id="menu_property_title_deed"
              name="Title Deed"
              action="action_title_deed_state"
              parent="property_sales.menu_property_sales_management_root"
               groups="property_sales.group_property_sales_crm,property_sales.group_property_sales_crm_manager,property_sales.group_property_sales_manager,property_sales.group_booking_general_approval,property_sales.group_booking_finance_approval"
              sequence="14"/>
</odoo>