<odoo>
  <!-- mail to agent with link -->
    <record id="mail_template_lead_registration" model="mail.template">
        <field name="name">Lead Registration Link</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="partner_to" eval="False"/>
        <field name="subject">Please complete your Lead Registration</field>
        <field name="email_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="body_html" type="html">
            <div>
                <p>Hi,</p>
                <p>Please complete your registration by clicking the link below:</p>
                <p>
                  <a t-attf-href="/lead/register"
                     style="display:inline-block; padding:12px 26px;
                            background-color:#28a745; color:white;
                            border-radius:30px; text-decoration:none;
                            font-weight:600;">
                     Complete Registration
                  </a>
                </p>
                <p>Thanks,<br/> <t t-out="object.company_id.name"/></p>
            </div>
        </field>
    </record>

  <!-- notify salesman when agent submits -->
  <record id="mail_template_submission_notify_salesman" model="mail.template">
    <field name="name">Lead Created Registration (Notify Salesman)</field>
    <field name="model_id" ref="model_res_partner"/>
    <field name="subject">Lead has submitted registration: {{object.name}}</field>
    <field name="email_from"></field>
    <field name="email_from"></field>
    <field name="body_html"><![CDATA[
      <p>Lead Registration,</p>
      <p>Lead <strong><t t-esc="object.name"/></strong> has Created registration.</p>
      <p>
        <a t-attf-href="#{object.env['ir.config_parameter'].sudo().get_param('web.base.url')}/web#id=#{object.id}&model=res.partner&view_type=form"
           style="
               background-color:#875A7B;
               color:#ffffff;
               padding:10px 18px;
               text-decoration:none;
               border-radius:4px;
               font-weight:600;
               display:inline-block;
           ">
            Open Record
        </a>
    </p>
    ]]></field>
  </record>

</odoo>
