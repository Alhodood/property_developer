<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherited_property" model="ir.ui.view">
        <field name="name">view.res.partner.form.property.inherited</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="6"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="client_type" invisible="par_type != 'lead'"/>
                <field name="par_type"/>
                <field name="is_verified" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="before">
                <header>
                    <style>
                        .card-header {
                        display: flex;
                        align-items: center;
                        cursor: pointer;
                        font-size:14px;
                        }

                        .card-header .arrow {
                        transition: transform 0.3s ease;
                        font-size: 16px;
                        }

                        /* Rotate when open */
                        .card-header.collapsed .arrow {
                        transform: rotate(-90deg);
                        }
                        .strong_tab{
                        margin-left:1%;
                        }
                        .card{
                        margin-bottom:1%;
                        }
                        .strong_gap{
                        display:inline-block;
                        min-width:140px;
                        }
                    </style>
                    <field name="lead_status" widget="statusbar"
                           invisible="par_type != 'agent'"
                           options="{'clickable': '1', 'fold_field': 'fold'}"
                           nolabel="1"/>
                    <button name="action_verify_partner"
                            type="object"
                            string="Verify"
                            class="btn btn-primary"
                            invisible="par_type != 'lead' or is_verified == True"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="date_of_birth"/>
                <field name="age"/>
                <field name="date_of_marriage" invisible="1"/>
                <field name="project_ids" widget="many2many_tags"
                       invisible="par_type != 'lead'"/>
                <field name="lead_agent_id" invisible="par_type != 'lead'"/>
                <field name="apartment_no" invisible="par_type != 'lead'"/>
                <field name="apartment_no_arabic" invisible="par_type != 'lead'"/>
            </xpath>
            <xpath expr="//notebook" position="before">
                <div class="card" invisible="par_type != 'lead'">
                    <div class="card-header" data-bs-toggle="collapse"
                         data-bs-target="#arabic-section" aria-expanded="true">
                        <span class="arrow">▼</span>
                        <strong class="strong_tab">Arabic</strong>
                    </div>
                    <div id="arabic-section" class="collapse show">
                        <div class="card-body"
                             style="display: flex; justify-content: space-between; gap: 40px;">

                            <!-- First Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Name(arabic) :
                                    </strong>
                                    <field name="name_arabic"/>
                                </p>
                            </div>

                            <!-- Second Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Nationality :
                                    </strong>
                                    <field name="nationality_id"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Nationality
                                        Arabic :
                                    </strong>
                                    <field name="nationality_arabic"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card" invisible="par_type != 'lead'">
                    <div class="card-header" data-bs-toggle="collapse"
                         data-bs-target="#segmentation-section"
                         aria-expanded="true">
                        <span class="arrow">▼</span>
                        <strong class="strong_tab">Segmentation</strong>
                    </div>
                    <div id="segmentation-section" class="collapse show">
                        <div class="card-body"
                             style="display: flex; justify-content: space-between; gap: 40px;">
                            <!-- First Column -->
                            <div style="flex: 1;">
                                <p invisible="1">
                                    <strong class="strong_gap"></strong>
                                    <field name="lead_status"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Lead Priority
                                        :
                                    </strong>
                                    <field name="lead_priority"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Referred By :
                                    </strong>
                                    <field name="referred_by"/>
                                </p>
                            </div>

                            <!-- Second Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Campaign :
                                    </strong>
                                    <field name="campaign_id"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Medium :
                                    </strong>
                                    <field name="medium_id"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Source :
                                    </strong>
                                    <field name="source_id"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card" invisible="par_type not in ('lead', 'tenant')">
                    <div class="card-header" data-bs-toggle="collapse"
                         data-bs-target="#identity-section"
                         aria-expanded="true">
                        <span class="arrow">▼</span>
                        <strong class="strong_tab">Identity Information
                        </strong>
                    </div>
                    <div id="identity-section" class="collapse show">
                        <div class="card-body"
                             style="display: flex; justify-content: space-between; gap: 40px;">
                            <!-- First Column -->
                            <div style="flex: 1;">
                                <p style="text-align:center;border-bottom: 1px solid #ccc; padding-bottom: 2px;font-weight:bold;">
                                    EMIRATES ID
                                </p>
                                <p>
                                    <strong class="strong_gap">EMIRATES ID
                                    </strong>
                                    <field name="emirates_id_attachment_id"
                                           filename="emirates_id_filename"/>
                                </p>
                                <field name="emirates_id_filename"
                                       invisible="1"/>
                                <p>
                                    <strong class="strong_gap">Emirates ID :
                                    </strong>
                                    <field name="emirates_id"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Emirates ID Date
                                        Of Issue :
                                    </strong>
                                    <field name="emirates_id_issue"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Emirates ID Date
                                        Of Expiry :
                                    </strong>
                                    <field name="emirates_id_expiry"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Non Resident :
                                    </strong>
                                    <field name="non_resident"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Visa Date Of
                                        Issue :
                                    </strong>
                                    <field name="visa_date_of_issue"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Place Of Issue
                                        :
                                    </strong>
                                    <field name="place_of_issue"/>
                                </p>
                            </div>

                            <!-- Second Column -->
                            <div style="flex: 1;">
                                <p style="text-align:center;border-bottom: 1px solid #ccc; padding-bottom: 2px;font-weight:bold;">
                                    PASSPORT
                                </p>
                                <p>
                                    <strong class="strong_gap">Passport :
                                    </strong>
                                    <field name="passport_attachment_id"
                                           filename="passport_filename"/>
                                </p>
                                <field name="passport_filename" invisible="1"/>
                                <p>
                                    <strong class="strong_gap">Passport No :
                                    </strong>
                                    <field name="passport_number"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Passport Date Of
                                        Issue :
                                    </strong>
                                    <field name="passport_date_of_issue"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Passport Date Of
                                        Expiry :
                                    </strong>
                                    <field name="passport_date_of_expiry"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Visa Number :
                                    </strong>
                                    <field name="visa_number"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Visa Date Of
                                        Expiry :
                                    </strong>
                                    <field name="visa_date_of_expiry"/>
                                </p>
                            </div>
                        </div>
                        <p style="padding:3%;">
                            <strong class="strong_gap">Additional Comments:
                            </strong>
                            <field name="additional_comments"/>
                        </p>
                    </div>
                </div>
                <div class="card" invisible="par_type != 'lead'">
                    <div class="card-header" data-bs-toggle="collapse"
                         data-bs-target="#home-section" aria-expanded="true">
                        <span class="arrow">▼</span>
                        <strong class="strong_tab">HOME PREFERENCE</strong>
                    </div>
                    <div id="home-section" class="collapse show">
                        <div class="card-body"
                             style="display: flex; justify-content: space-between; gap: 40px;">
                            <!-- First Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Property Type
                                        :
                                    </strong>
                                    <field name="property_type_id"/>
                                </p>
                            </div>

                            <!-- Second Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Number Of
                                        Bedrooms :
                                    </strong>
                                    <field name="no_of_bedroom"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card" invisible="par_type != 'tenant'">
                    <div class="card-header" data-bs-toggle="collapse"
                         data-bs-target="#home-section" aria-expanded="true">
                        <span class="arrow">▼</span>
                        <strong class="strong_tab">Employment &amp; Financials</strong>
                    </div>
                    <div id="home-section" class="collapse show">
                        <div class="card-body"
                             style="display: flex; justify-content: space-between; gap: 40px;">
                            <!-- First Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Profession / Job Title
                                        :
                                    </strong>
                                    <field name="profession_job_tital"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Monthly Income Rang
                                        :
                                    </strong>
                                    <field name="monthly_income_range"/>
                                </p>
                            </div>

                            <!-- Second Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Employer Name
                                        :
                                    </strong>
                                    <field name="employer_name"/>
                                </p>
                                 <p>
                                    <strong class="strong_gap">Work Address
                                        :
                                    </strong>
                                    <field name="work_address"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card" invisible="par_type != 'lead'">
                    <div class="card-header" data-bs-toggle="collapse"
                         data-bs-target="#budget-section" aria-expanded="true">
                        <span class="arrow">▼</span>
                        <strong class="strong_tab">BUDGET</strong>
                    </div>
                    <div id="budget-section" class="collapse show">
                        <div class="card-body"
                             style="display: flex; justify-content: space-between; gap: 40px;">
                            <!-- First Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">BUDGET RANGE :
                                    </strong>
                                    <field name="budget_range"/>
                                </p>
                            </div>

                            <!-- Second Column -->
                            <div style="flex: 1;">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card" invisible="par_type != 'lead'">
                    <div class="card-header" data-bs-toggle="collapse"
                         data-bs-target="#comm-section" aria-expanded="true">
                        <span class="arrow">▼</span>
                        <strong class="strong_tab">Communication Preference
                        </strong>
                    </div>
                    <div id="comm-section" class="collapse show">
                        <div class="card-body"
                             style="display: flex; justify-content: space-between; gap: 40px;">
                            <!-- First Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Preferred
                                        Language :
                                    </strong>
                                    <field name="preferred_language"/>
                                </p>
                            </div>

                            <!-- Second Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Primary Contact
                                        Mode :
                                    </strong>
                                    <field name="primary_contact"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card" invisible="par_type != 'lead'">
                    <div class="card-header" data-bs-toggle="collapse"
                         data-bs-target="#web-section" aria-expanded="true">
                        <span class="arrow">▼</span>
                        <strong class="strong_tab">WEB TO LEAD</strong>
                    </div>
                    <div id="web-section" class="collapse show">
                        <div class="card-body"
                             style="display: flex; justify-content: space-between; gap: 40px;">
                            <!-- First Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Your Message :
                                    </strong>
                                    <field name="your_message"
                                           style="width:60%;"/>
                                </p>
                            </div>

                            <!-- Second Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Subject :
                                    </strong>
                                    <field name="subject" style="width:60%;"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card" invisible="par_type != 'agent'">
                    <div class="card-header" data-bs-toggle="collapse"
                         data-bs-target="#agent-section" aria-expanded="true">
                        <span class="arrow">▼</span>
                        <strong class="strong_tab">Agent Details</strong>
                    </div>
                    <div id="agent-section" class="collapse show">
                        <div class="card-body"
                             style="display: flex; justify-content: space-between; gap: 40px;">
                            <!-- First Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Rera Number :
                                    </strong>
                                    <field name="rera_number"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Trade Licence
                                        Number :
                                    </strong>
                                    <field name="trade_license_number"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Agent briefing
                                        :
                                    </strong>
                                    <field name="agent_briefing"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Has Relationship
                                        manager? :
                                    </strong>
                                    <field name="has_relationship_manager"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Relationship
                                        manager Email :
                                    </strong>
                                    <field name="rm_email"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Relationship
                                        manager Agent :
                                    </strong>
                                    <field name="passport_number_agent"/>
                                </p>
                            </div>

                            <!-- Second Column -->
                            <div style="flex: 1;">
                                <p>
                                    <strong class="strong_gap">Rera Number :
                                    </strong>
                                    <field name="rera_number"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Trade Licence
                                        Expiry :
                                    </strong>
                                    <field name="trade_license_expiry"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">No Of Branches
                                        :
                                    </strong>
                                    <field name="no_of_branches"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Relationship
                                        manager Mobile :
                                    </strong>
                                    <field name="rm_mobile"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">UAE Residence
                                        :
                                    </strong>
                                    <field name="uae_residence"/>
                                </p>
                                <p>
                                    <strong class="strong_gap">Passport Expiry
                                        :
                                    </strong>
                                    <field name="passport_expiry"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Unit Blocking Request" name="blocking_request"
                      invisible="par_type != 'lead'">
                    <field name="property_blocking_request_ids" readonly="1"
                           widget="one2many">
                        <list string="Unit Blocking" editable="bottom"
                              delete="0" create="0">
                            <field name="partner_id" column_invisible="1"/>
                            <field name="sequence_code" readonly="1"/>
                            <field name="crm_id"
                                   readonly="1"/>
                            <field name="property_project_id" readonly="1"/>
                            <field name="property_unit_id"
                                   readonly="1"/>
                            <field name="partner_id"
                                   readonly="1"/>
                            <field name="start_date" readonly="1"/>
                            <field name="end_date"/>
                            <field name="no_of_days"/>
                            <field name="user_id" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </list>
                    </field>
                </page>
                <page string="Offers"
                      name="sale_Offers" invisible="par_type != 'lead'">
                    <field name="sale_offer_ids"
                           readonly="1"
                           widget="one2many">
                        <list string="Offers" editable="bottom"
                              delete="0" create="0">
                            <field name="partner_id"
                                   column_invisible="1"/>
                            <field name="name" readonly="1"/>
                            <field name="property_project_id"
                                   readonly="1"/>
                            <field name="property_unit_id"
                                   readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </list>
                    </field>
                </page>
                <page name="invoices_ids_lines" string="Invoices"
                      groups="account.group_account_user,account.group_account_manager"
                      invisible="par_type != 'lead'">
                    <field name="invoices_ids" readonly="1"
                           widget="one2many">
                        <list string="Invoices"
                              delete="0" create="0">
                            <field name="partner_id"
                                   column_invisible="1"/>
                            <field name="property_project_id"/>
                            <field name="property_unit_id"/>
                            <field name="name" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="invoice_date" readonly="1"/>
                            <field name="invoice_date_due" readonly="1"/>
                            <field name="amount_total_in_currency_signed"
                                   readonly="1"/>
                            <field name="amount_residual_signed" readonly="1"/>
                            <field name="status_in_payment" readonly="1"/>
                        </list>
                    </field>
                </page>
                <page name="payment_lines" string="Payments"
                      groups="account.group_account_user,account.group_account_manager"
                      invisible="par_type != 'lead'">
                    <field name="payment_ids" readonly="1"
                           widget="one2many">
                        <list string="Payments"
                              delete="0" create="0">
                            <field name="partner_id"
                                   column_invisible="1"/>
                            <field name="property_project_id"
                                   readonly="1"/>
                            <field name="property_unit_id"
                                   readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </list>
                    </field>
                </page>
                <page string="Leads"
                      name="crm_lead_ids_Offers"
                      invisible="par_type != 'lead'">
                    <field name="crm_lead_ids"
                           readonly="1"
                           widget="one2many">
                        <list string="Leads" editable="bottom"
                              delete="0" create="0">
                            <field name="partner_id"
                                   column_invisible="1"/>
                            <field name="name" readonly="1"/>
                            <field name="property_project_id"
                                   readonly="1"/>
                            <field name="property_unit_id"
                                   readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="stage_id" readonly="1"/>
                        </list>
                    </field>
                </page>
                <page string="Leads"
                      name="crm_lead_lead_agent_ids" invisible="par_type != 'agent'">
                    <field name="crm_lead_lead_agent_ids"
                           readonly="1"
                           widget="one2many">
                       <list string="Agent Leads" editable="bottom"
                              delete="0" create="0">
                            <field name="lead_agent_id"
                                   column_invisible="1"/>
                            <field name="name" readonly="1"/>
                            <field name="property_project_id"
                                   readonly="1"/>
                            <field name="property_unit_id"
                                   readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="stage_id" readonly="1"/>
                        </list>
                    </field>
                </page>
                <page string="Sales Offers"
                      name="sale_offer_lead_agent_ids" invisible="par_type != 'agent'">
                    <field name="sale_offer_lead_agent_ids"
                           readonly="1"
                           widget="one2many">
                       <list string="Offers" editable="bottom"
                              delete="0" create="0">
                            <field name="lead_agent_id"
                                   column_invisible="1"/>
                            <field name="name" readonly="1"/>
                            <field name="property_project_id"
                                   readonly="1"/>
                            <field name="property_unit_id"
                                   readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </list>
                    </field>
                </page>
                <page string="SPA" groups="property_sales.group_property_sales_crm,property_sales.group_property_sales_crm_manager,property_sales.group_property_sales_manager,property_sales.group_booking_general_approval,property_sales.group_booking_finance_approval"
                      invisible="par_type != 'lead'"
                      name="sap_ids_page">
                    <field name="spa_ids"
                           readonly="1"
                           widget="one2many">
                        <list string="SPA" editable="bottom"
                              delete="0" create="0">
                            <field name="property_unit_id" column_invisible="1"/>
                            <field name="property_project_id" column_invisible="1"/>
                            <field name="sequence" readonly="1"/>
                              <field name="offer_booking"/>
                              <field name="crm_id"/>
                              <field name="crm_user_id"/>
                              <field name="activity_ids" optional="hide" widget="list_activity"/>
                              <field name="activity_user_id" optional="hide" string="Activity by" widget="many2one_avatar_user"/>
                             <field name="status" readonly="1"/>
                        </list>
                    </field>
                </page>
                <page string="Booking" groups="sales_team.group_sale_salesman,sales_team.group_sale_salesman_all_leads,sales_team.group_sale_manager"
                      invisible="par_type != 'lead'"
                      name="booking_offer_ids_page">
                    <field name="booking_offer_ids"
                           readonly="1"
                           widget="one2many">
                        <list string="Booking" editable="bottom"
                              delete="0" create="0">
                               <field name="property_unit_id" column_invisible="1"/>
                            <field name="property_project_id"
                                   readonly="1"/>
                            <field name="sequence" readonly="1"/>
                            <field name="date_booking" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="activity_ids" optional="hide" widget="list_activity"/>
                            <field name="activity_user_id" optional="hide" string="Activity by" widget="many2one_avatar_user"/>
                            <field name="payment_plan_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="sales_approved_type" readonly="1" widget="badge" decoration-info="1"/>
                            <field name="finance_approved_type" readonly="1" widget="badge" decoration-warning="1"/>
                            <field name="general_approved_type" readonly="1" widget="badge" decoration-success="1"/>
                        </list>
                    </field>
                </page>
                <page string="Oqood" groups="property_sales.group_property_sales_crm,property_sales.group_property_sales_crm_manager,property_sales.group_property_sales_manager,property_sales.group_booking_general_approval,property_sales.group_booking_finance_approval"
                      invisible="par_type != 'lead'"
                      name="oqood_ids_page">
                    <field name="oqood_ids"
                           readonly="1"
                           widget="one2many">
                        <list string="Oqood" editable="bottom"
                              delete="0" create="0">
                            <field name="property_project_id" column_invisible="1"/>
