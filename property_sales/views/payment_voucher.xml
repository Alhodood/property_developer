<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_voucher_view_form_times" model="ir.ui.view">
        <field name="name">payment.voucher.view.form.times</field>
        <field name="model">payment.voucher</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post"
                            type="object"
                            string="Post"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money"
                                string="Payments">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Payments</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state =='posted'"/>

                        </group>
                        <group>
                              <field name="company_id" readonly="state =='posted'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Collected Cheques" name="payment_cheques">
                            <field name="cheque_line_ids" readonly="state =='posted'">
                                <list editable="bottom">
                                    <field name="voucher_id" column_invisible="1"/>
                                    <field name="cheque_date"/>
                                    <field name="cheque_number"/>
                                    <field name="amount" sum="Total Payment"/>
                                    <field name="currency_id"/>
                                    <field name="available_journal_ids" column_invisible="1"/>
                                    <field name="journal_id"/>
                                    <field name="available_payment_method_line_ids" column_invisible="1"/>
                                    <field name="payment_method_id"/>
                                    <field name="property_project_id" />
                                    <field name="property_unit_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                 <chatter/>
            </form>
        </field>
    </record>

       <record id="view_payment_voucher_tree" model="ir.ui.view">
        <field name="name">payment.voucher.tree</field>
        <field name="model">payment.voucher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

     <record id="action_payment_voucher" model="ir.actions.act_window">
            <field name="name">Payment Vouchers</field>
            <field name="res_model">payment.voucher</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_payment_voucher_tree"/>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p>
                    Create and manage your Payment Voucher
                </p>
             </field>
    </record>

      <menuitem id="menu_payment_voucher_root"
                name="Payment Voucher"
                parent="accountant.menu_accounting"
                sequence="10">

        <menuitem id="menu_payment_voucher"
                  name="Payment Vouchers"
                  action="action_payment_voucher"
                  sequence="10"
        />

      </menuitem>
</odoo>