<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_form_offer_booking" model="ir.ui.view">
        <field name="name">offer.booking.form.view</field>
        <field name="model">offer.booking</field>
        <field name="arch" type="xml">
            <form string="Offer Booking">
                <style>
                    .card-header {
                    display: flex;
                    align-items: center;
                    cursor: pointer;
                    font-size:14px;
                    }

                    .card-header .arrow {
                    transition: transform 0.3s ease;
                    font-size: 16px;
                    }

                    /* Rotate when open */
                    .card-header.collapsed .arrow {
                    transform: rotate(-90deg);
                    }
                    .strong_tab{
                    margin-left:1%;
                    }
                    .card{
                    margin-bottom:1%;
                    }
                    .strong_gap{
                    display:inline-block;
                    min-width:140px;
                    }
                </style>
                <header>
                    <field name="status" widget="statusbar" readonly="1"
                           options="{'clickable': '0'}"/>
                    <button name="action_dp_paid"
                            type="object"
                            string="DP Paid"
                            class="btn btn-primary"
                            invisible="status != 'draft'"
                    />
                     <button name="action_agreement_sent"
                            type="object"
                            string="Agreement Sent"
                            class="btn btn-primary"
                            invisible="status != 'dp_paid'"
                    />
                    <button name="action_agreement_signed"
                            type="object"
                            string="Agreement Signed"
                            class="btn btn-primary"
                            invisible="status != 'agreement_send'"
                    />
                    <button name="action_kyc_completed"
                            type="object"
                            string="KYC Completed"
                            class="btn btn-primary"
                            invisible="status != 'agreement_signed'"
                    />
                    <button name="action_onhold"
                            type="object"
                            string="On Hold"
                            class="btn btn-warning"
                            invisible="status != 'draft'"
                    />
                     <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn btn-secondary"
                            invisible="status in ['agreement_signed','kyc_competed','cancel']"
                    />
                     <button name="action_unhold"
                            type="object"
                            string="Un Hold"
                            class="btn btn-success"
                            invisible="status != 'on_hold'"
                    />
                     <button name="action_generate_payment_lines"
                            type="object"
                            string="Generate Payment Lines"
                            class="btn btn-primary"
                            invisible="1"
                    />
                    <button name='action_sales_manager_approval'
                            type="object"
                            string="Sales Manager Approve"
                            groups="property_sales.group_booking_sales_approval"
                            class="btn btn-primary"
                            invisible="status != 'kyc_competed' or sales_approved == True"
                    />
                     <button name='action_finance_approval'
                            type="object"
                            string="Finance Manager Approve"
                             groups="property_sales.group_booking_finance_approval"
                            class="btn btn-primary"
                            invisible="status != 'kyc_competed' or finance_approved == True or sales_approved == False"
                    />
                    <button name='action_general_approval'
                            type="object"
                            string="General Manager Approve"
                             groups="property_sales.group_booking_general_approval"
                            class="btn btn-primary"
                            invisible="status != 'kyc_competed' or general_approved == True or finance_approved == False"
                    />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Waiting For Sales Approval" bg_color="text-bg-success" invisible="sales_approved == True or status != 'kyc_competed'"/>
                    <widget name="web_ribbon" title="Waiting For Finance Approval" bg_color="text-bg-success" invisible="finance_approved == True or sales_approved == False or status != 'kyc_competed'"/>
                    <widget name="web_ribbon" title="Waiting For GM Approve" bg_color="text-bg-success" invisible="general_approved == True or finance_approved == False or sales_approved == False or status != 'kyc_competed'"/>
                    <widget name="web_ribbon" title="Sales Approved" bg_color="text-bg-success" invisible="sales_approved == False or finance_approved == True"/>
                    <widget name="web_ribbon" title="Finance Approved" bg_color="text-bg-success" invisible="finance_approved == False or general_approved == True"/>
                    <widget name="web_ribbon" title="GM Approved" bg_color="text-bg-success" invisible="general_approved == False"/>
                    <widget name="web_ribbon" title="Booking Pending (25+ Days)" bg_color="bg-warning" invisible="kyc_warning_level != 'warning'"/>
                    <widget name="web_ribbon" title="Booking CRITICAL (60+ Days)" bg_color="bg-danger" invisible="kyc_warning_level != 'critical'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="sequence" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sale_id"/>
                            <field name="sales_approved" readonly="1"/>
                            <field name="sales_approved_type" readonly="1"/>
                            <field name="general_approved" readonly="1"/>
                            <field name="general_approved_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="kyc_warning_level" readonly="status != 'draft'"/>
                            <field name="crm_id" readonly="status != 'draft'"/>
                            <field name="partner_id" readonly="status != 'draft'"/>
                            <field name="total_rounded_amount" readonly="status != 'draft'"/>
                            <field name="finance_approved" readonly="1"/>
                            <field name="finance_approved_type" readonly="1"/>
                            <field name="generate_line" invisible="1"/>
                            <field name="invoice_id" invisible="1"/>
                            <field name="dp_completed" invisible="1"/>
                            <field name="oqood_paid" decoration-success="oqood_paid == 'yes'" decoration-warning="oqood_paid == 'no'"/>
                            <field name="dld_paid"  decoration-success="dld_paid == 'yes'" decoration-warning="dld_paid == 'no'"/>
                             <field name="dp_status_text"
                                   readonly="1"
                                    invisible="dp_completed == True"/>
                            <field name="dp_status_text"
                                   readonly="1"
                                   class="text-success fw-bold"
                                    invisible="dp_completed == False"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="BOOKING DETAILS" name="project_details">
                            <div class="card">
                                <div class="card-header"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#prjdetail-section"
                                     aria-expanded="true">
                                    <span class="arrow">▼</span>
                                    <strong class="strong_tab">PROPERTY DETAILS
                                    </strong>
                                </div>
                                <div id="prjdetail-section"
                                     class="collapse show">
                                    <div class="card-body"
                                         style="display: flex; justify-content: space-between; gap: 40px;">
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Project:
                                                </strong>
                                                <field name="property_project_id" readonly="status != 'draft'"/>
                                            </p>

                                            <p>
                                                <strong class="strong_gap">
                                                    Company:
                                                </strong>
                                                <field name="company_id" readonly="status != 'draft'"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Currency:
                                                </strong>
                                                <field name="currency_id" readonly="status != 'draft'"/>
                                            </p>

                                            <p>
                                                <strong class="strong_gap">
                                                    Date Booking:
                                                </strong>
                                                <field name="date_booking" readonly="status != 'draft'"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Due Date:
                                                </strong>
                                                <field name="due_date" readonly="status != 'draft'"/>
                                            </p>

                                             <p invisible="1">
                                                <strong class="strong_gap">
                                                    Days Since Booking:
                                                </strong>
                                                <field name="days_since_booking"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Due on:
                                                </strong>
                                                <field name="days_since_booking_text"/>
                                            </p>

                                              <p invisible="1">
                                                <strong class="strong_gap">
                                                    KYC Warning:
                                                </strong>
                                                <field name="kyc_warning_level"/>
                                            </p>

                                            <p>
                                                <strong class="strong_gap">
                                                    Agent:
                                                </strong>
                                                <field name="lead_agent_id" readonly="status != 'draft'"/>
                                            </p>
                                        </div>
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Project Name Ar(إســم
                                                    الـمشروع):
                                                </strong>
                                                <field name="project_name_arabic"
                                                       style="padding-left:2%;" readonly="status != 'draft'"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Company Arabic:
                                                </strong>
                                                <field name="company_arabic"
                                                       style="padding-left:2%;" readonly="status != 'draft'"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Final Property Sale Value:
                                                </strong>
                                                <field name="final_total_property_value"
                                                       style="padding-left:2%;" readonly="status != 'draft'"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Final Sale Total Value:
                                                </strong>
                                                <field name="final_sale_value"
                                                       style="padding-left:2%;" readonly="status != 'draft'"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Sales Person:
                                                </strong>
                                                <field name="user_id"
                                                       readonly="1"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#unit-section"
                                     aria-expanded="true">
                                    <span class="arrow">▼</span>
                                    <strong class="strong_tab">UNIT DETAILS
                                    </strong>
                                </div>
                                <div id="unit-section" class="collapse show">
                                    <div class="card-body"
                                         style="display: flex; justify-content: space-between; gap: 40px;">
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Unit:
                                                </strong>
                                                <field name="property_unit_id" readonly="status != 'draft'"
                                                       required="1"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Net
                                                    Area (Sqft):
                                                </strong>
                                                <field name="net_area" readonly="status != 'draft'"/>
                                            </p>
                                            <p>
                                                <field name="allowed_payment_plan_ids"
                                                       widget="many2many_tags"
                                                       invisible="1"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Payment Plan:
                                                </strong>
                                                <field name="payment_plan_id" readonly="status != 'draft'"/>
                                            </p>
                                        </div>
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">Unit
                                                    Type:
                                                </strong>
                                                <field name="type_id"  options="{'no_open': True, 'no_quick_create': True}"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Unit Sale Price:
                                                </strong>
                                                <field name="php"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Booking Cost:
                                                </strong>
                                                <field name="booking_cost"/>
                                            </p>

                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header collapsed"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#system-section"
                                     aria-expanded="false">
                                    <span class="arrow">▼</span>
                                    <strong class="strong_tab">System
                                        Information
                                    </strong>
                                </div>
                                <div id="system-section" class="collapse">
                                    <div class="card-body"
                                         style="display: flex; justify-content: space-between; gap: 40px;">

                                        <!-- First Column -->
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Created
                                                    By:
                                                </strong>
                                                <field name="create_uid"/>
                                                <field name="create_date"
                                                       style="margin-left:1%;"/>
                                            </p>
                                        </div>

                                        <!-- Second Column -->
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">Last
                                                    Modified By:
                                                </strong>
                                                <field name="write_uid"/>
                                                <field name="write_date"
                                                       style="margin-left:1%;"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                        <page string="BUYER DETAILS (بيـانـات المـشتري)"
                              name="buyer_details">
                            <field name="property_buyer_ids"
                                   widget="one2many">
                                <list string="BUYER DETAILS" editable="bottom"
                                      delete="1" create="1">
                                    <field name="offer_id"
                                           column_invisible="1"/>
                                    <field name="buyer_id"/>
                                    <field name="owner_share"/>
                                    <field name="relationship"/>
                                    <field name="date_of_birth"/>
                                    <field name="age"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payment Schedule(جدول الدفـع ( خطـة الدفـع))"
                              name="payment_schedule">
                            <button name="action_export_plan_lines"
                                        type="object"
                                        string="Export"
                                        invisible="status not in ['draft','dp_paid','agreement_send']"
                                        class="btn-primary"/>
                             <span style="margin-right:10px !important;"></span>
                            <button name="action_import_plan_lines"
                                    type="object"
                                    string="Import"
                                    invisible="status not in ['draft','dp_paid','agreement_send']"
                                    class="btn-primary"/>
                             <span style="margin-right:10px !important;"></span>
                            <button name="action_edit_lines_offer"
                                type="object"
                                string="Edit"
                                invisible="status not in ['draft','dp_paid','agreement_send']"
                                class="btn-primary"/>
                            <field name="payment_schedule_ids"
                                   widget="one2many">
                                <list string="Payment Schedule"
                                      editable="bottom" limit="200"
                                      delete="0" create="0">
                                    <field name="offer_id"
                                           column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="plan_date"/>
                                    <field name="payment_id" column_invisible="1"/>
                                    <field name="is_booking" column_invisible="1"/>
                                    <field name="percentage" sum="Total Percentage" readonly="1"/>
                                    <field name="amount" sum="Total Amount" />
                                    <field name="rounded_amount" sum="Total Rounded Amount" readonly="1"/>
                                    <field name="invoice_id" readonly="1" optional="show"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                    <field name="inv_created"
                                           column_invisible="1"/>
                                    <field name="inv_status" readonly="1" optional="show"/>
                                    <field name="pay_status" readonly="1" optional="show"/>
                                    <field name="amount_residual" optional="show"
                                           readonly="1"/>
                                    <button name="action_create_invoice"
                                            type="object"
                                            string="Create Invoice"
                                            class="btn btn-primary"
                                            invisible="1"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="OTHER GOVERNMENT CHARGES(رسـوم حكـومـية اخرى)"
                              name="other_govt_charges">
                            <field name="other_gov_line_ids" readonly="1"
                                   widget="one2many">
                                <list string="OTHER GOVERNMENT CHARGES"
                                      editable="bottom"
                                      delete="1" create="1">
                                    <field name="offer_id"
                                           column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="NOTES" name="notes">
                            <field name="terms_and_condition"/>
                        </page>
                        <page string="NOTES(ملاحظات)" name="notes_arabic">
                            <field name="terms_and_condition_arabic"/>
                        </page>
<!--                        <page string="SPA" name="spa">-->
<!--                            <field name="spa_ids" readonly="1"-->
<!--                                   widget="one2many">-->
<!--                                <list string="SPA DETAILS" editable="bottom"-->
<!--                                      delete="0" create="0">-->
<!--                                    <field name="sequence"/>-->
<!--                                    <field name="status"/>-->
<!--                                    <field name="offer_booking"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                        </page>-->
<!--                        <page string="Oqood" name="oqood">-->
<!--                            <field name="oqood_ids" readonly="1"-->
<!--                                   widget="one2many">-->
<!--                                <list string="OQOOD DETAILS" editable="bottom"-->
<!--                                      delete="0" create="0">-->
<!--                                    <field name="sequence"/>-->
<!--                                    <field name="status"/>-->
<!--                                    <field name="offer_booking"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                        </page>-->
<!--                        <page string="Snagging Units" name="snagging">-->
<!--                            <field name="snagging_ids" readonly="1"-->
<!--                                   widget="one2many">-->
<!--                                <list string="SNAGGING DETAILS" editable="bottom"-->
<!--                                      delete="0" create="0">-->
<!--                                    <field name="sequence"/>-->
<!--                                    <field name="status"/>-->
<!--                                    <field name="offer_booking"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                        </page>-->
<!--                        <page string="Key Handover" name="key_handover">-->
<!--                            <field name="key_handover_ids" readonly="1"-->
<!--                                   widget="one2many">-->
<!--                                <list string="KEY HANDOVER DETAILS" editable="bottom"-->
<!--                                      delete="0" create="0">-->
<!--                                    <field name="sequence"/>-->
<!--                                    <field name="status"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                        </page>-->
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_offer_booking_tree" model="ir.ui.view">
        <field name="name">offer.booking.tree.view</field>
        <field name="model">offer.booking</field>
        <field name="arch" type="xml">
            <list string="Offer Booking" create="1" delete="1" decoration-warning="kyc_warning_level=='warning'" decoration-danger="kyc_warning_level=='critical'">
                <field name="sequence" readonly="1"/>
                <field name="kyc_warning_level" column_invisible="1"/>
                <field name="date_booking" readonly="1"/>
                <field name="user_id" readonly="1"/>
                <field name="activity_ids" optional="hide" widget="list_activity"/>
                <field name="activity_user_id" optional="hide" string="Activity by" widget="many2one_avatar_user"/>
                <field name="property_project_id" readonly="1"/>
                <field name="property_unit_id" readonly="1"/>
                <field name="payment_plan_id" readonly="1"/>
                <field name="company_id" readonly="1"/>
                 <field name="due_date"/>
                 <field name="days_since_booking_text"/>
                <field name="status" readonly="1"/>
                <field name="dp_completed" column_invisible="1"/>
                <field name="oqood_paid" widget="badge" decoration-success="oqood_paid == 'yes'" decoration-warning="oqood_paid == 'no'"/>
                <field name="dld_paid"  widget="badge" decoration-success="dld_paid == 'yes'" decoration-warning="dld_paid == 'no'"/>
                 <field name="dp_status_text"
                        readonly="1"
                        decoration-success="dp_completed == True"
                        decoration-warning="dp_completed == False"
                 />
                <field name="sales_approved_type" readonly="1" widget="badge" decoration-info="1"/>
                <field name="finance_approved_type" readonly="1" widget="badge" decoration-warning="1"/>
                <field name="general_approved_type" readonly="1" widget="badge" decoration-success="1"/>
            </list>
        </field>
    </record>

    <record id="view_offer_booking_search" model="ir.ui.view">
        <field name="name">offer.booking.search.view</field>
        <field name="model">offer.booking</field>
        <field name="arch" type="xml">
            <search string="Search Booking">
                <field name="sequence"/>
                <field name="partner_id"/>
                <field name="property_project_id"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <separator/>
                <filter string="KYC Completed"
                        name="kyc_completed"
                        domain="[('status','=','kyc_competed')]"/>
                <filter string="Waiting Sales Approval"
                        name="waiting_sales"
                        domain="[('status','=','kyc_competed'),
                                 ('sales_approved','=',False)]"/>
                <filter string="Sales Approved"
                        name="sales_approved"
                        domain="[('sales_approved','=',True)]"/>
                <filter string="Waiting Finance Approval"
                        name="waiting_finance"
                        domain="[('status','=','kyc_competed'),
                                 ('sales_approved','=',True),
                                 ('finance_approved','=',False)]"/>
                <filter string="Finance Approved"
                        name="finance_approved"
                        domain="[('finance_approved','=',True)]"/>
                <filter string="Waiting GM Approval"
                        name="waiting_gm"
                        domain="[('status','=','kyc_competed'),
                                 ('sales_approved','=',True),
                                 ('finance_approved','=',True),
                                 ('general_approved','=',False)]"/>
                <filter string="GM Approved"
                        name="gm_approved"
                        domain="[('general_approved','=',True)]"/>

                <group>
                    <filter string="Status" name="group_status"
                            context="{'group_by':'status'}"/>
                    <filter string="Sales Person" name="group_sales_person"
                            context="{'group_by':'user_id'}"/>
                    <filter string="Property" name="group_property"
                            context="{'group_by':'property_project_id'}"/>
                    <filter string="Property Unit" name="group_property_unit"
                            context="{'group_by':'property_unit_id'}"/>
                    <filter string="Company" name="group_company"
                            context="{'group_by':'company_id'}"/>
                </group>

            </search>
        </field>
    </record>


    <record id="action_offer_booking_state" model="ir.actions.act_window">
        <field name="name">Booking</field>
        <field name="res_model">offer.booking</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_offer_booking_tree"/>
        <field name="domain">[]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p>
                Create and manage your Property Booking
            </p>
        </field>
    </record>

    <menuitem id="menu_property_offer_booking"
              name="Booking"
              action="action_offer_booking_state"
              groups="sales_team.group_sale_salesman,sales_team.group_sale_salesman_all_leads,sales_team.group_sale_manager"
              parent="property_sales.menu_property_sales_management_root"
              sequence="12"/>

</odoo>