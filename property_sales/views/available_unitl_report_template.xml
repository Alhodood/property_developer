<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_available_property_unit">
           <t t-call="web.html_container">
               <t t-set="data_report_landscape" t-value="True"/>
        <t t-call="web.basic_layout">
            <div t-attf-class="header">
            </div>
         <div class="mt-0">
             <div class="page">
                <h2 class="text-center">
                    Available Property Unit – <t t-esc="company.name"/>
                </h2>
                  <div class="oe_structure"></div>
                 <br></br>
                <table class="table table-sm table-bordered"
                       style="font-size:10px;width:100%;border-collapse: collapse;border:1px solid #000;">

                        <tr style="border:1px solid #000;background-color:#FBE2D5;">
                            <th style="border:1px solid #000;font-weight:700;" class="text-center" width="1%"><strong>S.No</strong></th>
                            <th style="border:1px solid #000;font-weight:700;"  class="text-center" width="3%"><strong>Unit No</strong></th>
                            <th style="border:1px solid #000;font-weight:700;"  class="text-center" width="3%"><strong>Floor</strong></th>
                            <th style="border:1px solid #000;font-weight:700;" class="text-center"  width="10%"><strong>Project</strong></th>
                            <th style="border:1px solid #000;font-weight:700;" class="text-center"  width="4%"><strong>Type</strong></th>
                            <th style="border:1px solid #000;font-weight:700;" class="text-center" width="6%"><strong>Flat Area (sft)</strong></th>
                            <th style="border:1px solid #000;font-weight:700;" class="text-center"  width="5%"><strong>Balcony Area (sft)</strong></th>
                            <th style="border:1px solid #000;font-weight:700;"  class="text-center" width="6%"><strong>TOTAL (sft)</strong></th>
                            <th style="border:1px solid #000;font-weight:700;" class="text-center"  width="6%"><strong>Price/ PSF AED</strong></th>
                            <th style="border:1px solid #000;font-weight:700;" class="text-center"  width="10%"><strong>View</strong></th>
                            <th style="border:1px solid #000;font-weight:700;"  class="text-center" width="8%"><strong>Final Target Price (AED)</strong></th>
                            <th style="border:1px solid #000;font-weight:700;" class="text-center" width="8%"><strong>Title Deed (AED)</strong></th>
                            <th style="border:1px solid #000;font-weight:700;" class="text-center" width="8%"><strong>Oqood (AED)</strong></th>
                            <th style="border:1px solid #000;font-weight:700;"  class="text-center" width="8%"><strong>Total Purchase Price (AED)</strong></th>
                            <th style="border:1px solid #000;font-weight:700;" class="text-center" width="8%"><strong>Comments</strong></th>
                            <th style="border:1px solid #000;font-weight:700;"  class="text-center" width="6%"><strong>STATUS</strong></th>
                        </tr>
                    <tbody style="border:1px solid #000;">
                          <t t-set="index" t-value="1"/>
                        <t t-foreach="docs" t-as="unit">
                            <tr style="page-break-inside: avoid;border:1px solid #000;"
                                 t-att-style="'background-color:%s;' % unit.type_id.color if unit.type_id.color else''"
                            >

                                <td class="text-center" style="border:1px solid #000;">
                                    <t t-esc="index"/></td>
                                <td class="text-center" style="border:1px solid #000;"><t t-esc="unit.name"/></td>
                                <td style="border:1px solid #000;" class="text-center"><t t-esc="unit.floor_no"/></td>
                                <td style="border:1px solid #000;"><t t-esc="unit.project_id.name"/></td>
                                <td style="border:1px solid #000;" class="text-center"><t t-esc="unit.type_id.name"/></td>
                                <td style="border:1px solid #000;" class="text-end"><t t-esc="unit.apartment_area"/></td>
                                <td style="border:1px solid #000;" class="text-end"><t t-esc="unit.balcony_area"/></td>
                                <td style="border:1px solid #000;" class="text-end"><strong><t t-esc="unit.total_size"/></strong></td>
                                <td style="border:1px solid #000;font-weight:700;" class="text-end"><strong><t t-esc="unit.price_psf"/></strong></td>
                                <td style="border:1px solid #000;font-weight:700;"><strong><t t-esc="unit.view_unit"/></strong></td>
                                <td style="border:1px solid #000;font-weight:700;" class="text-end"><strong><t t-esc="unit.php"/></strong></td>
                                <td style="border:1px solid #000;font-weight:700;" class="text-end"><strong><t t-esc="unit.title_deed_value"/></strong></td>
                                <td style="border:1px solid #000;font-weight:700;" class="text-end"><strong><t t-esc="unit.oqood_value"/></strong></td>
                                <td style="border:1px solid #000;font-weight:700;" class="text-end"><strong><t t-esc="unit.total_purchase_value"/></strong></td>
                                <td width="10%" style="border:1px solid #000;"></td>
                                <td style="border:1px solid #000;font-weight:700;" class="text-center"><strong>AVAILABLE</strong></td>
                            </tr>
                             <t t-set="index" t-value="index + 1"/>
                        </t>
                    </tbody>
                </table>
            </div>
            </div>
            <div t-attf-class="footer o_standard_footer">
                    <div class="text-center">
                        <div style="border-top: 2px solid black; margin-bottom: 10px;"></div>
                        <div t-if="report_type == 'pdf'" class="text-muted">
                            Page:
                            <span class="page"/>
                            of
                            <span class="topage"/>
                        </div>
                    </div>
                </div>
        </t>
           </t>
    </template>
</odoo>
