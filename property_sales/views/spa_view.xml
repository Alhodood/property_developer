<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_spa_book" model="ir.ui.view">
        <field name="name">spa.book.form.view</field>
        <field name="model">spa.book</field>
        <field name="arch" type="xml">
            <form string="SPA">
                <style>
                    .card-header {
                        display: flex;
                        align-items: center;
                        cursor: pointer;
                        font-size:14px;
                    }

                    .card-header .arrow {
                        transition: transform 0.3s ease;
                        font-size: 16px;
                    }

                    /* Rotate when open */
                    .card-header.collapsed .arrow {
                        transform: rotate(-90deg);
                    }
                    .strong_tab{
                        margin-left:1%;
                    }
                    .card{
                        margin-bottom:1%;
                    }
                    .strong_gap{
                        display:inline-block;
                        min-width:140px;
                    }
                    </style>
                <header>
                    <field name="status" widget="statusbar" readonly="1"/>
                    <field name="is_verified" invisible="1"/>
                    <field name="plan_updated" invisible="1"/>
                    <field name="inv_created" invisible="1"/>
                    <field name="generate_commission" invisible="1"/>
                    <button name="spa_verify" type="object" string="Update Info"
                            class="btn btn-primary"
                            invisible="status != 'draft' or is_verified == True"/>
                    <button name='action_legal_review'
                            type="object"
                            string="Legal Review"
                            class="btn btn-primary"
                            invisible="status != 'draft' or is_verified == False"
                    />
                    <button name='action_waiting_client'
                            type="object"
                            string="Waiting For Client Acceptance"
                            class="btn btn-primary"
                            invisible="status != 'legal_review'"
                    />
                    <button name='action_accept_client'
                            type="object"
                            string="Client Accept"
                            class="btn btn-primary"
                            invisible="status != 'waiting_for_client_acceptance'"
                    />
                     <button name='action_sales_manager_approval'
                            type="object"
                            string="Crm Manager Approve"
                            groups="property_sales.group_property_sales_crm_manager"
                            class="btn btn-primary"
                            invisible="status != 'client_accept'"
                    />
                     <button name='action_finance_approval'
                            type="object"
                            string="Finance Manager Approve"
                             groups="property_sales.group_booking_finance_approval"
                            class="btn btn-primary"
                            invisible="status != 'sales_manager_approved'"
                    />
                    <button name='action_general_approval'
                            type="object"
                            string="General Manager Approve"
                             groups="property_sales.group_booking_general_approval"
                            class="btn btn-primary"
                            invisible="status != 'finance_manager_approved'"
                    />
                     <button name='action_generate_commission'
                            type="object"
                            string="Generate Commission"
                            class="btn btn-primary"
                            invisible="status != 'general_manager_approved' or generate_commission == True"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_invoice_created" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                string="Invoice">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                          <button name="action_view_collected_pdc" type="object"
                                class="oe_stat_button" icon="fa-money"
                                string="Collected PDC">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Collected PDC
                                </span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="sequence" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="offer_booking" readonly="is_verified == True"/>
                        </group>
                        <group>
                              <field name="crm_user_id" readonly="1"/>
                              <field name="partner_id" readonly="1"/>
                              <field name="payment_term_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="BOOKING DETAILS" name="project_details">
                            <div class="card">
                                <div class="card-header"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#prjdetail-section"
                                     aria-expanded="true">
                                    <span class="arrow">▼</span>
                                    <strong class="strong_tab">PROPERTY DETAILS
                                    </strong>
                                </div>
                                <div id="prjdetail-section"
                                     class="collapse show">
                                    <div class="card-body"
                                         style="display: flex; justify-content: space-between; gap: 40px;">
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Project:
                                                </strong>
                                                <field name="property_project_id"/>
                                            </p>

                                            <p>
                                                <strong class="strong_gap">
                                                    Company:
                                                </strong>
                                                <field name="company_id"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Currency:
                                                </strong>
                                                <field name="currency_id"/>
                                            </p>

                                            <p>
                                                <strong class="strong_gap">
                                                    Date:
                                                </strong>
                                                <field name="date_booking"/>
                                            </p>

                                            <p>
                                                <strong class="strong_gap">
                                                    Agent:
                                                </strong>
                                                <field name="lead_agent_id"/>
                                            </p>
                                        </div>
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Project Name Ar(إســم
                                                    الـمشروع):
                                                </strong>
                                                <field name="project_name_arabic" style="padding-left:2%;"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Company Arabic:
                                                </strong>
                                                <field name="company_arabic" style="padding-left:2%;"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Final Property Sale Value:
                                                </strong>
                                                <field name="final_total_property_value" style="padding-left:2%;"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Final Sale Total Value:
                                                </strong>
                                                <field name="final_sale_value" style="padding-left:2%;"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Sales Person:
                                                </strong>
                                                <field name="user_id"
                                                       readonly="1"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Spa Sign Date:
                                                </strong>
                                                <field name="spa_sign_date" required="status not in ['draft','waiting_for_client_acceptance','legal_review']"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#unit-section"
                                     aria-expanded="true">
                                    <span class="arrow">▼</span>
                                    <strong class="strong_tab">UNIT DETAILS
                                    </strong>
                                </div>
                                <div id="unit-section" class="collapse show">
                                    <div class="card-body"
                                         style="display: flex; justify-content: space-between; gap: 40px;">
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Unit:
                                                </strong>
                                                <field name="property_unit_id"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Net
                                                    Area (Sqft):
                                                </strong>
                                                <field name="net_area"/>
                                            </p>
                                            <p>
                                                <field name="allowed_payment_plan_ids"
                                                       widget="many2many_tags"
                                                       invisible="1"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Payment Plan:
                                                </strong>
                                                <field name="payment_plan_id" options="{'no_create': True, 'no_open': True,'no_create_edit':True}"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">Inquiry:
                                                </strong>
                                                <field name="crm_id"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Offer:
                                                </strong>
                                                <field name="sale_id"/>
                                            </p>
                                        </div>
                                        <div style="flex: 1;">
                                             <p>
                                                <strong class="strong_gap">Unit Type:
                                                </strong>
                                                <field name="type_id"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">PHP:
                                                </strong>
                                                <field name="php"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Booking Cost:
                                                </strong>
                                                <field name="booking_cost"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#courier-section"
                                     aria-expanded="true">
                                    <span class="arrow">▼</span>
                                    <strong class="strong_tab">Courier Details
                                    </strong>
                                </div>
                                <div id="courier-section" class="collapse show">
                                    <div class="card-body"
                                         style="display: flex; justify-content: space-between; gap: 40px;">
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Courier Name:
                                                </strong>
                                                <field name="courier_name"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Dispatch Date:
                                                </strong>
                                                <field name="dispatch_date"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Chairman Sign Date:
                                                </strong>
                                                <field name="chair_man_sign_date"/>
                                            </p>
                                        </div>
                                        <div style="flex: 1;">
                                             <p>
                                                <strong class="strong_gap">Tracking No :
                                                </strong>
                                                <field name="tracking_no"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">Delivery Confirmation :
                                                </strong>
                                                <field name="delivery_confirmation"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header collapsed"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#system-section"
                                     aria-expanded="false">
                                    <span class="arrow">▼</span>
                                    <strong class="strong_tab">System Information
                                    </strong>
                                </div>
                        <div id="system-section" class="collapse">
                            <div class="card-body"
                                 style="display: flex; justify-content: space-between; gap: 40px;">

                                <!-- First Column -->
                                <div style="flex: 1;">
                                    <p>
                                        <strong class="strong_gap">Created
                                            By:
                                        </strong>
                                        <field name="create_uid"/>
                                        <field name="create_date"
                                               style="margin-left:1%;"/>
                                    </p>
                                </div>

                                <!-- Second Column -->
                                <div style="flex: 1;">
                                    <p>
                                        <strong class="strong_gap">Last
                                            Modified By:
                                        </strong>
                                        <field name="write_uid"/>
                                        <field name="write_date"
                                               style="margin-left:1%;"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                        </page>
                        <page string="BUYER DETAILS (بيـانـات المـشتري)"
                              name="buyer_details">
                            <field name="property_buyer_ids" readonly="1"
                                   widget="one2many">
                                <list string="BUYER DETAILS" editable="bottom"
                                      delete="0" create="0">
                                    <field name="offer_id"
                                           column_invisible="1"/>
                                    <field name="buyer_id"/>
                                    <field name="owner_share"/>
                                    <field name="relationship"/>
                                </list>
                            </field>
                        </page>
                         <page string="Payment Schedule(جدول الدفـع ( خطـة الدفـع))"
                              name="payment_plan_line">
                               <button name="action_open_update_payment_wizard"
                                type="object"
                                string="Update Plan"
                                invisible="is_verified == False or status not in ['draft','legal_review','waiting_for_client_acceptance'] or inv_created == True"
                                class="btn btn-primary"
                                 style="margin-right:10px !important;"
                               />
                             <span style="margin-right:10px !important;"></span>
                             <button name='action_create_invoice'
                                    type="object"
                                    string="Create Invoice"
                                    class="btn btn-primary"
                                   invisible="inv_created == True"
                                    style="margin-right:10px !important;"
                                />
                             <span style="margin-right:10px !important;"></span>
                             <button name='action_collect_pdc'
                                    type="object"
                                    string="Collect Pdc"
                                    class="btn btn-primary"
                                      style="margin-right:10px !important;"
                            />
                              <separator/>
                             <field name="payment_plan_ids" readonly="1"
                                   widget="one2many">
                                <list string="Payment Schedule"
                                      editable="bottom" limit="100"
                                      delete="0" create="0">
                                    <field name="spa_id"
                                           column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="plan_date"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="is_booking" column_invisible="1"/>
                                    <field name="property_project_id" column_invisible="1"/>
                                    <field name="property_unit_id" column_invisible="1"/>
                                    <field name="payment_id" column_invisible="1"/>
                                    <field name="partner_id" column_invisible="1"/>
                                    <field name="percentage"  sum="Total Percentage"/>
                                    <field name="amount" readonly="1" sum="Total Amount"/>
                                    <field name="rounded_amount" readonly="1" sum="Total Rounded Amount"/>
                                    <field name="invoice_id" readonly="1" optional="show"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                    <field name="inv_created"
                                           column_invisible="1"/>
                                    <field name="inv_status" readonly="1" optional="show"/>
                                    <field name="pay_status" readonly="1" optional="show"/>
                                    <field name="amount_residual"
                                           readonly="1" optional="show"/>
                                    <button name="action_create_invoice"
                                            type="object"
                                            string="Create Invoice"
                                            class="btn btn-primary"
                                            invisible="1"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Payment Schedule Booking(جدول الدفـع ( خطـة الدفـع))"
                              name="payment_schedule" invisible="1">
                            <field name="payment_schedule_ids"
                                   widget="one2many">
                                <list string="Payment Schedule"
                                      editable="bottom"
                                      delete="0" create="0">
                                    <field name="offer_id"
                                           column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="plan_date"/>
                                    <field name="payment_id" column_invisible="1"/>
                                    <field name="percentage"/>
                                    <field name="amount"/>
                                     <field name="invoice_id" readonly="1"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                    <field name="inv_created"
                                           column_invisible="1"/>
                                    <field name="inv_status" readonly="1"/>
                                    <field name="pay_status" readonly="1"/>
                                    <field name="amount_residual"
                                           readonly="1"/>
                                    <button name="action_create_invoice"
                                            type="object"
                                            string="Create Invoice"
                                            class="btn btn-primary"
                                            invisible="inv_created == True"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="OTHER GOVERNMENT CHARGES(رسـوم حكـومـية اخرى)"
                              name="other_govt_charges">
                            <field name="other_gov_line_ids" readonly="1"
                                   widget="one2many">
                                <list string="OTHER GOVERNMENT CHARGES"
                                      editable="bottom"
                                      delete="0" create="0">
                                    <field name="offer_id"
                                           column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Oqood" name="oqood">
                            <field name="oqood_ids" readonly="1"
                                   widget="one2many">
                                <list string="OQOOD DETAILS" editable="bottom"
                                      delete="1" create="1">
                                    <field name="sequence"/>
                                    <field name="status"/>
                                    <field name="offer_booking"/>
                                </list>
                            </field>
                        </page>
                        <page string="Snagging Units" name="snagging">
                            <field name="snagging_ids" readonly="1"
                                   widget="one2many">
                                <list string="SNAGGING DETAILS" editable="bottom"
                                      delete="1" create="1">
                                    <field name="sequence"/>
                                    <field name="status"/>
                                    <field name="offer_booking"/>
                                </list>
                            </field>
                        </page>
                        <page string="Key Handover" name="key_handover">
                            <field name="key_handover_ids" readonly="1"
                                   widget="one2many">
                                <list string="KEY HANDOVER DETAILS" editable="bottom"
                                      delete="1" create="1">
                                    <field name="sequence"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                         <page string="Payments" name="payment_spa" groups="account.group_account_user,account.group_account_manager">
                            <field name="payment_ids" readonly="1"
                                   widget="one2many">
                                <list string="PaymentsS" editable="bottom"
                                      delete="1" create="1">
                                    <field name="property_unit_id" readonly="1"/>
                                    <field name="property_project_id"/>
                                      <field name="partner_id"
                                           readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="date" readonly="1"/>
                                    <field name="amount" readonly="1"/>
                                    <field name="state" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Terms and Condition" name="terms_description">
                            <field name="terms_description" widget="html" placeholder="SPA Report Description" groups="property_sales.group_spa_terms_modifier"/>
                        </page>
                        <page string="Plot Rule" name="terms_description_two">
                            <field name="terms_description_second_section" widget="html" placeholder="SPA Second Description" groups="property_sales.group_spa_terms_modifier"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

      <record id="view_spa_book_tree" model="ir.ui.view">
        <field name="name">spa.book.tree.view</field>
        <field name="model">spa.book</field>
        <field name="arch" type="xml">
            <list string="SPA" create="1" delete="1">
                <field name="sequence" readonly="1"/>
                  <field name="property_project_id"/>
                  <field name="property_unit_id"/>
                  <field name="offer_booking"/>
                  <field name="crm_id"/>
                  <field name="crm_user_id"/>
                  <field name="activity_ids" optional="hide" widget="list_activity"/>
                  <field name="activity_user_id" optional="hide" string="Activity by" widget="many2one_avatar_user"/>
                <field name="status" readonly="1"/>
            </list>
        </field>
    </record>

        <record id="view_spa_book_search" model="ir.ui.view">
        <field name="name">spa.book.search.view</field>
        <field name="model">spa.book</field>
        <field name="arch" type="xml">
            <search string="Search SPA">
                <field name="sequence"/>
                <field name="partner_id"/>
                <field name="property_project_id"/>
                <field name="property_unit_id"/>
                <field name="crm_id"/>

                <filter string="Waiting CRM Approval"
                        name="waiting_crm_approval"
                        domain="[('status', '=', 'client_accept')]"/>

                <filter string="CRM Approved"
                        name="crm_approved"
                        domain="[('status', '=', 'sales_manager_approved')]"/>

                <filter string="Waiting Finance Approval"
                        name="waiting_finance_approval"
                        domain="[('status', '=', 'sales_manager_approved')]"/>

                <filter string="Finance Approved"
                        name="finance_approved"
                        domain="[('status', '=', 'finance_manager_approved')]"/>

                <filter string="Waiting GM Approval"
                        name="waiting_gm_approval"
                        domain="[('status', '=', 'finance_manager_approved')]"/>
                <filter string="GM Approved"
                        name="gm_approved"
                        domain="[('status', '=', 'general_manager_approved')]"/>

                <group>
                    <filter string="Status" name ="group_by_status"
                            context="{'group_by': 'status'}"/>
                    <filter string="Project" name="group_by_projet"
                            context="{'group_by': 'property_project_id'}"/>
                    <filter string="Salesperson" name="group_by_sales_poerson"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Crm User" name="group_by_crm_user"
                            context="{'group_by': 'crm_user_id'}"/>
                </group>
            </search>
        </field>
    </record>


     <record id="action_spa_book" model="ir.actions.act_window">
        <field name="name">SPA</field>
        <field name="res_model">spa.book</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_spa_book_tree"/>
        <field name="search_view_id" ref="view_spa_book_search"/>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p>
                Create and manage your SPA
            </p>
        </field>
    </record>

     <menuitem id="menu_spa_book"
              name="SPA"
              action="action_spa_book"
              parent="property_sales.menu_property_sales_management_root"
               groups="property_sales.group_property_sales_crm,property_sales.group_property_sales_crm_manager,property_sales.group_property_sales_manager,property_sales.group_booking_general_approval,property_sales.group_booking_finance_approval"
              sequence="13"/>

</odoo>