<?xml version="1.0" encoding="UTF-8"?>
<odoo>
     <record id="view_termination_request" model="ir.ui.view">
        <field name="name">termination.request.form.view</field>
        <field name="model">termination.request</field>
        <field name="arch" type="xml">
            <form string="Termination Request">
                <style>
                    .card-header {
                        display: flex;
                        align-items: center;
                        cursor: pointer;
                        font-size:14px;
                    }

                    .card-header .arrow {
                        transition: transform 0.3s ease;
                        font-size: 16px;
                    }

                    /* Rotate when open */
                    .card-header.collapsed .arrow {
                        transform: rotate(-90deg);
                    }
                    .strong_tab{
                        margin-left:1%;
                    }
                    .card{
                        margin-bottom:1%;
                    }
                    .strong_gap{
                        display:inline-block;
                        min-width:140px;
                    }
                    </style>
                <header>
                    <field name="status" widget="statusbar" readonly="1"/>
                     <button name="action_under_review"
                        string="Under Review"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'new'"
                     />

                    <button name="action_review_completed"
                            string="Review Completed"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'under_review'"
                    />

                    <button name="action_terminate"
                            string="Terminate"
                            type="object"
                            class="btn-danger"
                            invisible="status != 'review_completed'"
                    />

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            invisible="status in ['terminate','cancel']"
                    />
                    <button name="action_notify_buyer"
                            string="Notify"
                            type="object"
                            class="btn-primary"
                            invisible="status in ['new', 'terminate', 'cancel']"
                    />
                </header>
                <sheet>
                     <div class="oe_button_box" name="button_box">
                     </div>
                    <div class="oe_title">
                        <h1>
                            <field name="sequence" readonly="1"/>
                        </h1>
                    </div>
                     <group>
                        <group>
                              <field name="property_project_id"/>
                              <field name="property_unit_id"/>
                              <field name="termination_type"/>
                              <field name="request_date" readonly="1"/>
                        </group>
                         <group>
                           <field name="user_id" readonly="1"/>
                           <field name="project_progress_percentage"/>
                           <field name="spa_id"/>
                           <field name="partner_id"/>
                           <field name="company_id" readonly="1"/>
                           <field name="pending_progress_percentage"/>
                         </group>
                     </group>
                     <notebook>
                          <page string="Termination Request" name="termination_requests">
                               <field name="reason_for_termination"/>
                          </page>
                     </notebook>
                </sheet>
                  <chatter/>
            </form>
        </field>
     </record>

    <record id="view_termination_request_tree" model="ir.ui.view">
        <field name="name">termination.request.tree.view</field>
        <field name="model">termination.request</field>
        <field name="arch" type="xml">
            <list string="Termination Request" create="1" delete="1">
                  <field name="property_project_id"/>
                  <field name="property_unit_id"/>
                  <field name="termination_type"/>
                  <field name="user_id"/>
                  <field name="partner_id"/>
                  <field name="request_date"/>
                  <field name="project_progress_percentage"/>
                  <field name="spa_id"/>
                 <field name="pending_progress_percentage"/>
            </list>
        </field>
    </record>

    <record id="view_termination_request_search" model="ir.ui.view">
    <field name="name">termination.request.search.view</field>
    <field name="model">termination.request</field>
    <field name="arch" type="xml">
        <search string="Termination Request">
            <field name="sequence"/>
            <field name="property_project_id"/>
            <field name="property_unit_id"/>
            <field name="user_id"/>

            <filter string="New" name="filter_new"
                    domain="[('status','=','new')]"/>
            <filter string="Under Review" name="filter_under_review"
                    domain="[('status','=','under_review')]"/>
            <filter string="Review Completed" name="filter_review_completed"
                    domain="[('status','=','review_completed')]"/>
            <filter string="Terminated" name="filter_terminated"
                    domain="[('status','=','terminate')]"/>
            <filter string="Cancelled" name="filter_cancelled"
                    domain="[('status','=','cancel')]"/>

            <group>
                <filter string="Status" context="{'group_by':'status'}" name="group_by_status"/>
                <filter string="Project" context="{'group_by':'property_project_id'}" name="group_by_project"/>
                <filter string="Requested By" context="{'group_by':'user_id'}" name="group_by_user"/>
                <filter string="Unit" context="{'group_by':'property_unit_id'}" name="group_by_unit"/>
                <filter string="Buyer" context="{'group_by':'partner_id'}" name="group_by_buyer"/>
            </group>
        </search>
    </field>
</record>



      <record id="action_termination_request" model="ir.actions.act_window">
            <field name="name">Termination Request</field>
            <field name="res_model">termination.request</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_termination_request_tree"/>
             <field name="search_view_id" ref="view_termination_request_search"/>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p>
                    Create and manage your Termination Request
                </p>
            </field>
    </record>

     <menuitem id="menu_termination_request"
              name="Termination Request"
              action="action_termination_request"
              parent="property_sales.menu_property_sales_management_root"
               groups="property_sales.group_property_sales_crm,property_sales.group_property_sales_crm_manager,property_sales.group_property_sales_manager,property_sales.group_booking_general_approval,property_sales.group_booking_finance_approval"
              sequence="16"/>
</odoo>