<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_form_oqood_registration" model="ir.ui.view">
        <field name="name">oqood.registration.form.view</field>
        <field name="model">oqood.registration</field>
        <field name="arch" type="xml">
            <form string="OQOOD Registration">
                <style>
                    .card-header {
                    display: flex;
                    align-items: center;
                    cursor: pointer;
                    font-size:14px;
                    }

                    .card-header .arrow {
                    transition: transform 0.3s ease;
                    font-size: 16px;
                    }

                    /* Rotate when open */
                    .card-header.collapsed .arrow {
                    transform: rotate(-90deg);
                    }
                    .strong_tab{
                    margin-left:1%;
                    }
                    .card{
                    margin-bottom:1%;
                    }
                    .strong_gap{
                    display:inline-block;
                    min-width:140px;
                    }
                </style>
                <header>
                    <field name="status" widget="statusbar" readonly="1"
                           options="{'clickable': '0'}"/>
                      <button name='action_waiting_for_finance_approval'
                            type="object"
                            string="Request For  Finance Approval"
                            class="btn btn-primary"
                            invisible="status != 'draft'"
                    />
                     <button name='action_approve_finance'
                            type="object"
                            string="Approve Finance"
                             groups="property_sales.group_booking_finance_approval"
                            class="btn btn-primary"
                            invisible="status != 'waiting_for_finance_approval'"
                    />

                    <button name='action_initiate_oqood'
                            type="object"
                            string="Initiate Oqood"
                            class="btn btn-primary"
                            invisible="status != 'draft' or initiate_oqood == True"
                    />

                    <button name='action_complete_oqood'
                            type="object"
                            string="Complete OQOOD"
                            class="btn btn-primary"
                            invisible="status != 'finance_approve'"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_my_task" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                string="Oqood">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Oqood Task</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="sequence" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="spa_id" required="1"/>
                            <field name="crm_user_id" required="1"/>
                        </group>
                        <group>
                            <field name="offer_booking" required="1"/>
                            <field name="oqood_dead_line" />
                            <field name="initiate_oqood"  invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Property DETAILS" name="project_details">
                            <div class="card">
                                <div class="card-header"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#prjdetail-section"
                                     aria-expanded="true">
                                    <span class="arrow">▼</span>
                                    <strong class="strong_tab">PROPERTY DETAILS
                                    </strong>
                                </div>
                                <div id="prjdetail-section"
                                     class="collapse show">
                                    <div class="card-body"
                                         style="display: flex; justify-content: space-between; gap: 40px;">
                                        <div style="flex: 1;">
                                             <p>
                                                <strong class="strong_gap">
                                                    Project:
                                                </strong>
                                                <field name="property_project_id"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">
                                                    Company:
                                                </strong>
                                                <field name="company_id"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Currency:
                                                </strong>
                                                <field name="currency_id"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">
                                                    Agent:
                                                </strong>
                                                <field name="lead_agent_id"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">
                                                    Unit:
                                                </strong>
                                                <field name="property_unit_id"
                                                       required="1"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Journal:
                                                </strong>
                                                <field name="journal_id"/>
                                            </p>

                                        </div>
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Project Name Ar(إســم
                                                    الـمشروع):
                                                </strong>
                                                <field name="project_name_arabic"
                                                       style="padding-left:2%;"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Company Arabic:
                                                </strong>
                                                <field name="company_arabic"
                                                       style="padding-left:2%;"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    Sales Person:
                                                </strong>
                                                <field name="user_id"
                                                       readonly="1"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">
                                                    SPA Sign Date:
                                                </strong>
                                                <field name="spa_sign_date"
                                                       readonly="1"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">Inquiry:
                                                </strong>
                                                <field name="crm_id"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Offer:
                                                </strong>
                                                <field name="sale_id"/>
                                            </p>

                                        </div>
                                    </div>
                                </div>
                            </div>
                               <div class="card">
                                <div class="card-header"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#courier-section"
                                     aria-expanded="true">
                                    <span class="arrow">▼</span>
                                    <strong class="strong_tab">Oqood Details
                                    </strong>
                                </div>
                                <div id="courier-section" class="collapse show">
                                    <div class="card-body"
                                         style="display: flex; justify-content: space-between; gap: 40px;">
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Registration Date:
                                                </strong>
                                                <field name="registration_date"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Reference No:
                                                </strong>
                                                <field name="reference_no"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">Status:
                                                </strong>
                                                <field name="oqood_status"/>
                                            </p>
                                        </div>
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">Client:
                                                </strong>
                                                <field name="partner_id"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">Client Sign Date :
                                                </strong>
                                                <field name="client_sign_date"/>
                                            </p>
                                             <p>
                                                <strong class="strong_gap">Chair Man Sign Date :
                                                </strong>
                                                <field name="chairman_sign_date"/>
                                            </p>
                                            <p>
                                                <strong class="strong_gap">DSR Status:
                                                </strong>
                                                <field name="dsr_status"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                               <div class="card">
                                <div class="card-header collapsed"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#system-section"
                                     aria-expanded="false">
                                    <span class="arrow">▼</span>
                                    <strong class="strong_tab">System
                                        Information
                                    </strong>
                                </div>
                                <div id="system-section" class="collapse">
                                    <div class="card-body"
                                         style="display: flex; justify-content: space-between; gap: 40px;">

                                        <!-- First Column -->
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">
                                                    Created
                                                    By:
                                                </strong>
                                                <field name="create_uid"/>
                                                <field name="create_date"
                                                       style="margin-left:1%;"/>
                                            </p>
                                        </div>

                                        <!-- Second Column -->
                                        <div style="flex: 1;">
                                            <p>
                                                <strong class="strong_gap">Last
                                                    Modified By:
                                                </strong>
                                                <field name="write_uid"/>
                                                <field name="write_date"
                                                       style="margin-left:1%;"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                 <chatter/>
            </form>
        </field>
    </record>
      <record id="view_oqood_registration_tree" model="ir.ui.view">
        <field name="name">oqood.registration.tree.view</field>
        <field name="model">oqood.registration</field>
        <field name="arch" type="xml">
            <list string="OQOOD Registration" create="1" delete="1">
                <field name="sequence" readonly="1"/>
                <field name="user_id" readonly="1"/>
                <field name="activity_ids" optional="hide" widget="list_activity"/>
                <field name="activity_user_id" optional="hide" string="Activity by" widget="many2one_avatar_user"/>
                <field name="property_project_id" readonly="1"/>
                <field name="property_unit_id" readonly="1"/>
                <field name="company_id" readonly="1"/>
                <field name="status" readonly="1"/>
            </list>
        </field>
    </record>


    <record id="view_oqood_registration_line_search" model="ir.ui.view">
        <field name="name">oqood.registration.search.view</field>
        <field name="model">oqood.registration</field>
        <field name="arch" type="xml">
            <search string="OQOOD Registration">
                 <field name="sequence"/>
                <field name="user_id" />
                <field name="property_project_id"/>
                <field name="property_unit_id" />
                <field name="company_id"/>
                <field name="status" />


                 <filter string="Pending"
                        name="snagging_pending"
                        domain="[('status', '=', 'draft')]"/>

                 <filter string="Finance Manager Approved"
                        name="finance_manager_approved"
                        domain="[('status', '=', 'finance_approve')]"/>

                <filter string="Completed"
                        name="oqood_completed"
                        domain="[('status', '=', 'completed')]"/>
                <group>
                    <filter string="Project" name="group_project"
                            context="{'group_by':'property_project_id'}"/>
                    <filter string="Unit" name="group_unit"
                            context="{'group_by':'property_unit_id'}"/>
                    <filter string="CRM User"
                        name="group_by_crm"
                        context="{'group_by':'crm_user_id'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

      <record id="action_oqood_registration_state" model="ir.actions.act_window">
        <field name="name">OQOOD Registration</field>
        <field name="res_model">oqood.registration</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_oqood_registration_tree"/>
        <field name="search_view_id" ref="view_oqood_registration_line_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>
                Create and manage your Property OQOOD Registration
            </p>
        </field>
    </record>

     <menuitem id="menu_property_oqood_registration"
              name="OQOOD Registration"
              action="action_oqood_registration_state"
              parent="property_sales.menu_property_sales_management_root"
               groups="property_sales.group_property_sales_crm,property_sales.group_property_sales_crm_manager,property_sales.group_property_sales_manager,property_sales.group_booking_general_approval,property_sales.group_booking_finance_approval"
              sequence="14"/>
</odoo>