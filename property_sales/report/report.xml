<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_sale_offer_report" model="report.paperformat">
        <field name="name">Sale Paper Format</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">230</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record
        id="action_report_sale_offer_pdf" model="ir.actions.report">
        <field name="name">Sale Offer Pdf</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">property_sales.sale_offer_report_template</field>
        <field name="report_file">property_sales.sale_offer_report_template</field>
        <field name="print_report_name">('SaleOffer - %s' % (object.name))</field>
        <field name="paperformat_id" ref="property_sales.paperformat_sale_offer_report"/>

    </record>


    <record id="paperformat_pdc_report" model="report.paperformat">
            <field name="name">PDC Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">297</field>
            <field name="page_width">230</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_pdc" model="ir.actions.report">
            <field name="name">PDC Report</field>
            <field name="model">pdc.payment.received</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">property_sales.pdc_receipt_template</field>
            <field name="report_file">property_sales.pdc_receipt_template</field>
            <field name="print_report_name">'PDC Report'</field>
            <field name="binding_model_id" ref="property_sales.model_pdc_payment_received"/>
            <field name="binding_type">report</field>
               <field name="paperformat_id" ref="property_sales.paperformat_pdc_report"/>
        </record>

        <record id="action_print_pdc_receipt" model="ir.actions.server">
            <field name="name">PDC Report</field>
            <field name="model_id" ref="property_sales.model_pdc_payment_received"/>
            <field name="binding_model_id"
                   ref="property_sales.model_pdc_payment_received"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = records.action_print_pdc_list()
            </field>
     </record>




    <record id="paperformat_spa_report" model="report.paperformat">
            <field name="name">SPA Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">297</field>
            <field name="page_width">230</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_spa" model="ir.actions.report">
            <field name="name">SPA Report</field>
            <field name="model">spa.book</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">property_sales.spa_report_template</field>
            <field name="report_file">property_sales.spa_report_template</field>
            <field name="print_report_name">'SPA Report'</field>
            <field name="binding_model_id" ref="property_sales.model_spa_book"/>
            <field name="binding_type">report</field>
               <field name="paperformat_id" ref="property_sales.paperformat_spa_report"/>
        </record>

        <record id="action_send_available_unit_report" model="ir.actions.server">
            <field name="name">Send</field>
            <field name="model_id" ref="model_property_unit"/>
            <field name="binding_model_id" ref="model_property_unit"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                action = records.action_send_available_unit_report()
            </field>
        </record>
</odoo>
