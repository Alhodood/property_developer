     <!-- ========================================================= -->
    <!-- Privilege Category for Discount Management -->
    <!-- ========================================================= -->
    <record model="res.groups.privilege" id="res_groups_privilege_client_discount">
        <field name="name">Discount Management</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>


     <!-- ========================================================= -->
    <!-- Discount User Group -->
    <!-- ========================================================= -->
    <record id="group_discount_user" model="res.groups">
        <field name="name">Discount User</field>
        <field name="comment">Can view their discount request.</field>
        <field name="privilege_id" ref="res_groups_privilege_client_discount"/>
    </record>

    <!-- ========================================================= -->
    <!-- Discount Approver Group -->
    <!-- ========================================================= -->
    <record id="group_discount_approver" model="res.groups">
        <field name="name">Discount Approver</field>
        <field name="comment">Full access to all their records.</field>
        <field name="privilege_id" ref="res_groups_privilege_client_discount"/>
    </record>

