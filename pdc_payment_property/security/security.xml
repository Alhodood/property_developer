<?xml version="1.0" encoding="UTF-8"?>
<odoo>

      <record id="pdc_payment_received_company_rule" model="ir.rule">
        <field name="name">PDC Payment Received: Multi Company</field>
        <field name="model_id" ref="model_pdc_payment_received"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

      <record id="pdc_payment_submit_company_rule" model="ir.rule">
        <field name="name">PDC Payment Submit: Multi Company</field>
        <field name="model_id" ref="model_pdc_payment_submit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>


</odoo>