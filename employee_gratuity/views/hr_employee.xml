<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherited_hrms" model="ir.ui.view">
        <field name="name">hr.employee.view.inherited.hrms.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="joining_date"/>
            </xpath>
            <xpath expr="//page[@name='resume']" position="after">
                <page name="gratuity" string="Gratuity">
                    <field name="gratuity_ids" readonly="1">
                        <list editable="bottom">
                            <field name="joining_date" readonly="1" string="Joining Date"/>
                            <field name="last_working_day" readonly="1" string="Today"/>
                            <field name="wage" readonly="1"/>
                            <field name="gratuity" sum="Gratuity"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>