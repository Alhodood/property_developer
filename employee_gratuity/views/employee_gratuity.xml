<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tree_employee_gratuity" model="ir.ui.view">
        <field name="name">employee.gratuity.tree.view</field>
        <field name="model">employee.gratuity</field>
        <field name="arch" type="xml">
            <list string="Gratuity" create="0" delete="0">
                <field name="user_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="employee_id" readonly="1"/>
                <field name="joining_date" readonly="1" string="Joining Date"/>
                <field name="last_working_day" readonly="1" string="Today"/>
                <field name="wage" readonly="1"/>
                <field name="gratuity" sum="Gratuity"/>
            </list>
        </field>
    </record>

    <record id="view_employee_gratuity_search" model="ir.ui.view">
        <field name="name">employee.gratuity.search.view</field>
        <field name="model">employee.gratuity</field>
        <field name="arch" type="xml">
            <search string="Search Gratuity">

                <!-- Quick search -->
                <field name="employee_id"/>

                <!-- Filters -->
                <filter string="My Records"
                        name="my_records"
                        domain="[('user_id', '=', uid)]"/>

                <separator/>

                <!-- Group By -->
                <group>
                    <filter string="Employee"
                            name="group_employee"
                            context="{'group_by': 'employee_id'}"/>

                    <filter string="Company"
                            name="group_company"
                            context="{'group_by': 'company_id'}"/>

                    <filter string="Joining Date"
                            name="group_joining_date"
                            context="{'group_by': 'joining_date'}"/>
                </group>

            </search>
        </field>
    </record>


    <record id="action_employee_gratuity" model="ir.actions.act_window">
        <field name="name">Gratuity</field>
        <field name="res_model">employee.gratuity</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_tree_employee_gratuity"/>
        <field name="search_view_id" ref="view_employee_gratuity_search"/>
        <field name="help" type="html">
            <p>
                Create Employee Gratuity
            </p>
        </field>
    </record>
    <menuitem
            name="Gratuity"
            id="menu_employee_gratuity"
            action="action_employee_gratuity"
            parent="hr.menu_hr_root"
            groups="hr.group_hr_manager"
            sequence="14"
    />
</odoo>