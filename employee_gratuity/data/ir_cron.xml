<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled action to sent mail about the document expiry.-->
        <record id="ir_cron_hr_employee_gratuity" model="ir.cron">
            <field name="name">Gratuity</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="model_hr_employee"/>
            <field name="state">code</field>
            <field name="nextcall" eval="DateTime.now().strftime('%Y-%m-%d 00:30:00')"/>
            <field name="code">model.generate_gratuity()</field>
        </record>
    </data>
</odoo>
