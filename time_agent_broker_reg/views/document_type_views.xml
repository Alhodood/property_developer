<odoo>
  <record id="view_reg_document_type_tree" model="ir.ui.view">
    <field name="name">reg.document.type.tree</field>
    <field name="model">reg.document.type</field>
    <field name="arch" type="xml">
      <list delete="1">
        <field name="name"/>
        <field name="required"/>
        <field name="sequence"/>
      </list>
    </field>
  </record>

  <record id="view_reg_document_type_form" model="ir.ui.view">
    <field name="name">reg.document.type.form</field>
    <field name="model">reg.document.type</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="required"/>
            <field name="sequence"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_reg_document_type" model="ir.actions.act_window">
    <field name="name">Document Types</field>
    <field name="res_model">reg.document.type</field>
    <field name="view_mode">list,form</field>
  </record>

    <menuitem id="menu_reg_doc_types" name="Document Types" parent="menu_reg_root" action="action_reg_document_type"/>
</odoo>
