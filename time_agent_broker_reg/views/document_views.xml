<odoo>
  <record id="view_reg_agent_document_tree" model="ir.ui.view">
    <field name="name">reg.agent.document.tree</field>
    <field name="model">reg.agent.document</field>
    <field name="arch" type="xml">
      <list>
        <field name="agent_id"/>
        <field name="name"/>
        <field name="expiry_date"/>
        <field name="verified"/>
      </list>
    </field>
  </record>

  <record id="view_reg_agent_document_form" model="ir.ui.view">
    <field name="name">reg.agent.document.form</field>
    <field name="model">reg.agent.document</field>
    <field name="arch" type="xml">
      <form>
          <header>
                <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="verified !='pending' or agent_id.status=='rejected'"/>
                <button name="action_reject" string="Reject" type="object" class="btn-secondary" invisible="verified !='pending' or agent_id.status=='rejected'"/>
                <field name="verified" widget="statusbar" readonly="1"/>
          </header>
        <sheet>
          <group>
            <field name="agent_id" readonly="1"/>
            <field name="doc_type_id" readonly="1"/>
            <field name="name" readonly="1"/>
            <field name="expiry_date" readonly="1"/>
              <field name="attachments_doc_mimetype"/>
              <field name="reason" invisible="verified != 'rejected'" readonly="1"/>
            <field name="file" filename="file_name" readonly="1" widget="pdf_viewer" invisible="attachments_doc_mimetype not in ['application/pdf']"/>
            <field name="file" filename="file_name" readonly="1" widget="image" invisible="attachments_doc_mimetype not in ['image/png', 'image/jpeg', 'image/jpg', 'image/webp']"/>
            <field name="file" filename="file_name" readonly="1" widget="binary" invisible="attachments_doc_mimetype in ['application/pdf']"
                               options="{'preview_image': false}"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

    <record id="view_reg_agent_document_search" model="ir.ui.view">
    <field name="name">reg.agent.document.search</field>
    <field name="model">reg.agent.document</field>
    <field name="arch" type="xml">
        <search string="Search Documents">

            <!-- 🔍 Quick Search Fields -->
            <field name="name" string="Document Name"/>
            <field name="file_name" string="File Name"/>
            <field name="agent_id" string="Agent"/>
            <field name="doc_type_id" string="Type"/>

            <!-- ⭐ Filters -->
            <filter name="filter_expired" string="Expired"
                    domain="[('expiry_date', '&lt;', context_today())]"/>

            <filter name="filter_no_expiry" string="No Expiry"
                    domain="[('expiry_date', '=', False)]"/>

            <filter name="filter_verified" string="Verified"
                    domain="[('verified','=','verified')]"/>

            <filter name="filter_rejected" string="Rejected"
                    domain="[('verified','=','rejected')]"/>

            <!-- 📁 Group By -->
            <group>
                <filter name="group_agent" string="Agent"
                        context="{'group_by':'agent_id'}"/>
                <filter name="group_type" string="Document Type"
                        context="{'group_by':'doc_type_id'}"/>
                <filter name="group_verified" string="Status"
                        context="{'group_by':'verified'}"/>
                <filter name="group_expiry" string="Expiry Date"
                        context="{'group_by':'expiry_date'}"/>
            </group>

        </search>
    </field>
</record>


  <record id="action_reg_agent_document" model="ir.actions.act_window">
    <field name="name">Agent Documents</field>
    <field name="res_model">reg.agent.document</field>
    <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="time_agent_broker_reg.view_reg_agent_document_search"/>
  </record>

  <menuitem id="menu_reg_documents" name="Agent Documents" parent="menu_reg_root" action="action_reg_agent_document"/>
</odoo>
