<odoo>
  <template id="portal_agent_register" name="Agent Registration Form">
  <t t-call="website.layout">
    <div class="container my-5">

      <!-- Page Header -->
      <div class="text-center mb-4">
        <h2 class="fw-bold" style="color:#2c3e50;">Agent Registration</h2>
        <p class="text-muted">Please fill out the form and upload your required documents.</p>
      </div>

      <div class="card shadow-lg p-4" style="border-radius:14px;">
        <form id="agent_form" action="/agent/register/submit" method="post" enctype="multipart/form-data">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="token" t-att-value="token"/>

          <!-- Basic Info -->
          <div class="row g-3 mb-4">

              <div class="mb-4">
                  <label class="form-label fw-semibold">Registration Type</label>

                  <div class="d-flex gap-4 mt-1">
                    <div class="form-check">
                      <input class="form-check-input"
                             type="radio"
                             name="is_company"
                             id="is_company_yes"
                             value="1"
                             checked="checked"/>
                      <label class="form-check-label" for="is_company_yes">
                        Company
                      </label>
                    </div>

                    <div class="form-check">
                      <input class="form-check-input"
                             type="radio"
                             name="is_company"
                             id="is_company_no"
                             value="0"/>
                      <label class="form-check-label" for="is_company_no">
                        Person
                      </label>
                    </div>
                  </div>
                </div>

              <div class="col-md-12 company-field person-only-field">
                <label class="form-label fw-semibold">Company</label>
                <select class="form-select company-only"
                        name="company_id"
                        >
                    <option value="">Select Company</option>
                    <t t-foreach="companies" t-as="c">
                        <option t-att-value="c.id">
                            <t t-esc="c.name"/>
                        </option>
                    </t>
                </select>
            </div>

            <div class="col-md-12">
              <label class="form-label fw-semibold">
                    Name <span class="text-danger">*</span>
              </label>
              <input class="form-control" name="name" type="text"
                     required="required"
                     placeholder="Name"
                     t-att-value="agent and agent.name or ''"/>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-semibold">
                Email <span class="text-danger">*</span>
                </label>
              <input class="form-control" name="email" type="email"
                     required="required"
                     pattern="^[^@\s]+@[^@\s]+\.[^@\s]+$"
                     placeholder="Demo@gmail.com"
                     t-att-value="agent and agent.email or ''"/>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-semibold">
                    Phone<span class="text-danger">*</span>
              </label>
              <input class="form-control"
                   name="phone"
                   type="tel"
                   required="required"
                   pattern="^[+]?[\d\s\-()]{6,20}$"
                   title="Enter a valid international phone number"
                     placeholder="Enter A Valid Phone Number"
                   t-att-value="agent and agent.phone or ''"/>
            </div>
          </div>

            <h4 class="fw-semibold mt-4" style="color:#34495e;">Address</h4>
            <div class="row g-3 mt-2">

              <div class="col-md-6">
                <label class="form-label">Street</label>
                <input class="form-control"
                       name="street"
                       type="text"
                       placeholder="Street"
                       t-att-value="agent and agent.street or ''"/>
              </div>

              <div class="col-md-6">
                <label class="form-label">Street 2</label>
                <input class="form-control"
                       name="street2"
                       type="text"
                       placeholder="Street2"
                       t-att-value="agent and agent.street2 or ''"/>
              </div>

              <div class="col-md-4">
                <label class="form-label">City</label>
                <input class="form-control"
                       name="city"
                       type="text"
                       placeholder="City"
                       t-att-value="agent and agent.city or ''"/>
              </div>

              <div class="col-md-4">
                <label class="form-label">ZIP</label>
                <input class="form-control"
                       name="zip"
                       type="text"
                       placeholder="ZIP"
                       t-att-value="agent and agent.zip or ''"/>
              </div>

                <div class="col-md-4">
                  <label class="form-label">State</label>
                  <select class="form-select" name="state_id" id="state_id">
                    <option value="">Select State</option>
                    <t t-foreach="states" t-as="s">
                      <option t-att-value="s.id"
                              t-att-data-country="s.country_id.id"
                              t-att-selected="agent and agent.state_id and agent.state_id.id == s.id">
                        <t t-esc="s.name"/>
                      </option>
                    </t>
                  </select>
                </div>

              <div class="col-md-12">
                  <label class="form-label">Country</label>
                  <select class="form-select" name="country_id" id="country_id">
                    <option value="">Select Country</option>
                    <t t-foreach="countries" t-as="c">
                      <option t-att-value="c.id"
                              t-att-selected="agent and agent.country_id and agent.country_id.id == c.id">
                        <t t-esc="c.name"/>
                      </option>
                    </t>
                  </select>
                </div>

            </div>

          <!-- Required Documents -->
          <h4 class="fw-semibold mt-4" style="color:#34495e;">Documents</h4>
          <div class="mt-3">

            <t t-foreach="doc_types" t-as="dt">
              <div class="border rounded p-3 my-3 bg-light">

                <label class="fw-semibold">
                  <t t-esc="dt.name"/>
                  <t t-if="dt.required">
                    <span class="text-danger"> (required)</span>
                  </t>
                </label>

                <div class="row g-3 mt-2">
                  <div class="col-md-6">
                    <input class="form-control"
                           type="file"
                           t-att-name="'doc_type_%s' % dt.id"
                           t-att-required="dt.required"
                           multiple="multiple"
                    />
                  </div>

                  <div class="col-md-6 d-flex align-items-center">
                        <label class="me-2 mb-0">Expiry:</label>
                        <input class="form-control expiry-field"
                               type="date"
                               t-att-name="'expiry_doc_%s' % dt.id"
                        />
                  </div>

                </div>

              </div>
            </t>

          </div>

          <!-- Extra Docs -->
          <h4 class="fw-semibold mt-4" style="color:#34495e;">Extra Document</h4>

          <div id="extra_docs_container" class="p-3 border rounded bg-light mb-4">

            <div class="row g-3 extra_doc_row">
              <div class="col-md-4">
                <input class="form-control" type="text"
                       name="extra_doc_name_1"
                       placeholder="Document Name"/>
              </div>
              <div class="col-md-4 d-flex align-items-center">
                  <label class="me-2 mb-0">Expiry:</label>
                <input class="form-control expiry-field" type="date"
                       name="extra_doc_expiry_1"/>
              </div>
              <div class="col-md-4">
                <input class="form-control" type="file"
                       name="extra_doc_file_1"
                       multiple="multiple"
                />
              </div>
            </div>

          </div>

            <!-- Comments -->
            <h4 class="fw-semibold mt-4" style="color:#34495e;">Additional Comments</h4>

            <div class="mt-2">
              <textarea
                class="form-control"
                name="description"
                rows="4"
                minlength="5"
                placeholder="Write any additional notes or comments here..."
                style="border-radius:10px; padding:12px;"></textarea>
            </div>

          <!-- Submit -->
          <div class="text-center mt-4">
            <button class="btn btn-primary px-5 py-2 fw-semibold"
                    style="border-radius:8px; background:#0074D9;">
              Submit
            </button>
          </div>

        </form>
      </div>

    </div>

    <!-- VALIDATION SCRIPTS -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            try {
                const companyYes = document.getElementById("is_company_yes"); // Company
                const companyNo  = document.getElementById("is_company_no");  // Person
                const companyField = document.querySelector(".person-only-field");
                const companySelect = document.getElementById("company_id");

                function toggleCompanyField() {
                    if (companyNo.checked) {
                        // PERSON → SHOW company dropdown
                        companyField.classList.remove("d-none");
                    } else if (companyYes.checked) {
                        // COMPANY → HIDE company dropdown
                        companyField.classList.add("d-none");
                        companySelect.value = "";
                    }
                }

                // Add event listeners
                companyYes.addEventListener("change", toggleCompanyField);
                companyNo.addEventListener("change", toggleCompanyField);

                // Set initial state
                toggleCompanyField();

            } catch (error) {
                console.error("Error toggling company field:", error);
            }

            const countrySelect = document.getElementById("country_id");
            const stateSelect = document.getElementById("state_id");

            function filterStates() {
                const countryId = countrySelect.value;

                Array.from(stateSelect.options).forEach(option => {
                    if (!option.value) return;

                    if (option.dataset.country === countryId) {
                        option.style.display = "";
                    } else {
                        option.style.display = "none";
                        option.selected = false;
                    }
                });
            }

            // On country change
            countrySelect.addEventListener("change", filterStates);

            // On page load (edit mode)
            filterStates();

            // Min expiry = today + 2 months
            let today = new Date();
            today.setMonth(today.getMonth() + 2);
            let minDate = today.toISOString().split("T")[0];

            document.querySelectorAll(".expiry-field").forEach(function (field) {
                field.setAttribute("min", minDate);
            });

            document.getElementById("agent_form").addEventListener("submit", function (e) {

                let hasError = false;

                /* REQUIRED + OPTIONAL DOC TYPES */
                document.querySelectorAll("input[type='file'][name^='doc_type_']").forEach(function (fileInput) {

                    if (fileInput.files.length > 0) {
                        let docId = fileInput.name.replace("doc_type_", "");
                        let expiry = document.querySelector("input[name='expiry_doc_" + docId + "']");

                        if (!expiry || !expiry.value) {
                            hasError = true;
                        }

                        if (expiry &amp;&amp; expiry.value &amp;&amp; expiry.value &lt; minDate) {
                            hasError = true;
                        }
                    }
                });

                /* EXTRA DOCUMENTS */
                document.querySelectorAll("input[type='file'][name^='extra_doc_file_']").forEach(function (fileInput) {

                    if (fileInput.files.length > 0) {
                        let idx = fileInput.name.replace("extra_doc_file_", "");
                        let name = document.querySelector("input[name='extra_doc_name_" + idx + "']");
                        let expiry = document.querySelector("input[name='extra_doc_expiry_" + idx + "']");

                        if ( !expiry || !expiry.value) {
                            hasError = true;
                        }

                        if(!name || !name.value){
                            e.preventDefault();
                            alert("Extra Document 'NAME' is Required");
                        }

                        if (expiry &amp;&amp; expiry.value &lt; minDate) {
                            hasError = true;
                        }
                    }
                });

                if (hasError) {
                    e.preventDefault();
                    alert("Expiry date is mandatory for all attached documents and must be valid.");
                }

            });

        });
        </script>

  </t>
</template>



  <template id="portal_agent_thanks" name="Thank You">
    <t t-call="website.layout">
        <section class="py-5" style="background:#f6f9fc;">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-6 col-md-8">

                        <div style="
                            background:white;
                            border-radius:16px;
                            padding:40px;
                            box-shadow:0 4px 20px rgba(0,0,0,0.08);
                            text-align:center;
                        ">
                            <!-- Success Icon -->
                            <div style="
                                width:80px;
                                height:80px;
                                background:#28a745;
                                border-radius:50%;
                                display:flex;
                                justify-content:center;
                                align-items:center;
                                margin:0 auto 20px auto;
                                color:white;
                                font-size:40px;
                                font-weight:bold;
                                box-shadow:0 4px 10px rgba(0,0,0,0.15);
                            ">
                                ✓
                            </div>

                            <h2 style="
                                font-size:32px;
                                font-weight:600;
                                color:#333;
                                margin-bottom:15px;
                            ">
                                Thank you <t t-esc="agent.name"/>
                            </h2>

                            <p style="
                                font-size:18px;
                                color:#555;
                                margin-bottom:25px;
                                line-height:1.6;
                            ">
                                Your registration has been successfully submitted.<br/>
                                Our team will review it and contact you shortly.
                            </p>

                            <a href="/" class="btn btn-primary btn-lg" style="
                                padding:12px 30px;
                                border-radius:50px;
                                font-size:16px;
                            ">
                                Back to Home
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </section>
    </t>
</template>


    <template id="portal_already_submitted" name="Already Submitted">
    <t t-call="website.layout">
        <section style="
            padding: 60px 0;
            background: linear-gradient(135deg, #E8F0FF 0%, #FFFFFF 100%);
        ">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-6 col-md-8">

                        <div style="
                            background: #fff;
                            border-radius: 18px;
                            padding: 40px;
                            text-align: center;
                            box-shadow: 0 6px 20px rgba(0,0,0,0.08);
                        ">

                            <h2 style="font-weight: 600; color: #2a4d8f; margin-bottom: 15px;">
                                Registration Already Completed
                            </h2>

                            <p style="font-size: 17px; color: #555;">
                                Hello <span style="font-weight:600; color:#222;">
                                    <t t-esc="agent.name"/>
                                </span>,
                                your registration has been successfully submitted.
                            </p>

                            <a href="/" class="btn btn-primary mt-4"
                               style="
                                    padding: 10px 25px;
                                    border-radius: 8px;
                                    font-size: 15px;
                                    background: #2a73ff;
                                    border: none;
                               ">
                                Go to Home
                            </a>

                        </div>

                    </div>
                </div>
            </div>
        </section>
    </t>
</template>

</odoo>
