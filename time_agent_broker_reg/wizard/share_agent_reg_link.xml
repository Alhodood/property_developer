<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_share_record_link_wizard" model="ir.ui.view">
        <field name="name">share.agent.reg.wizard.form</field>
        <field name="model">share.agent.reg.wizard</field>
        <field name="arch" type="xml">
            <form string="Share Record Link">
                <group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags" required="1"/>
                    </group>
                    <group>
                        <field name="record_url_html" nolabel="1"/><br/>
                    </group>
                </group>

                <footer>
                    <button string="Send Link"
                            type="object"
                            name="action_send_link"
                            class="btn-primary"/>

                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_share_record_link" model="ir.actions.act_window">
        <field name="name">Share Link</field>
        <field name="res_model">share.agent.reg.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>