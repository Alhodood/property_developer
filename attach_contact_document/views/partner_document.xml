<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--    Form view of hr_employee_document model-->
    <record id='res_partner_document_view_form' model='ir.ui.view'>
        <field name="name">partner.document.view.form</field>
        <field name="model">partner.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verified"/>
                    <button name="action_verify"
                            type="object"
                            string="Verify"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_expire_doc" string="Expired" type="object" invisible="state!='verified' or not is_expiry"/>

                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state!='draft'"/>
                            <field name="partner_id" string="Customer" readonly="state!='draft'"/>
                            <field name="document_type_id" readonly="state!='draft'"/>
                            <field name="pdoc_attachment_ids"
                                   widget="many2many_binary" class="oe_inline" readonly="state!='draft'"/>
                        </group>
                        <group>
                            <field name="issue_date" required="1"/>
                            <field name="is_expiry" readonly="state!='draft'"/>
                            <field name="expiry_date" readonly="state!='draft'" invisible="not is_expiry" required="1"/>
                            <field name="notification_type" readonly="state!='draft'" invisible="not is_expiry"/>
                            <field name="before_days"
                                   invisible="notification_type == 'single' or not is_expiry" readonly="state!='draft'"/>
                            <field name="notification_to" widget="many2many_tags" readonly="state!='draft'" invisible="not is_expiry"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attachment">
                            <field name="attachments_doc" widget="pdf_viewer" readonly="state!='draft'"/>
                        </page>
                        <page string="Description">
                            <field name="description" widget="html" readonly="state!='draft'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!--    Tree view of hr_employee_document model-->
    <record id='partner_document_tree_view' model='ir.ui.view'>
        <field name="name">partner.document.view.tree</field>
        <field name="model">partner.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id" string="Customer"/>
                <field name="document_type_id"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>
    <!--    Defines a search view for HR Employee Documents.-->
    <record id="res_partner_document_view_search" model="ir.ui.view">
        <field name="name">partner.document.view.search</field>
        <field name="model">partner.document</field>
        <field name="arch" type="xml">
            <search string="Customer Documents">
                 <field name="name"/>
                <field name="partner_id" string="Customer"/>
                  <separator/>
                <group>
                    <filter name="customer_filter" string="Customer" domain="[]"
                            context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <!--    Configures an action window for HR Employee Documents.-->
    <record id="partner_document_action" model="ir.actions.act_window">
        <field name="name">Customer Documents</field>
        <field name="res_model">partner.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="partner_document_tree_view"/>
        <field name="search_view_id" ref="res_partner_document_view_search"/>
          <field name="context">{'search_default_customer_filter': 1}</field>
    </record>
    <!--    Creates a menu item for HR Employee Documents.-->
    <menuitem id="partner_document_menu"
              name="Documents"
               sequence="2"
              parent="contacts.menu_contacts"
              action="partner_document_action"
             />
</odoo>
